generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum UserStatus {
  onboarding
  active
  paused
  // Soft-delete: set when a user chooses "Freeze" instead of deleting their
  // account. The User/Profile/embedding/verification/coordinates are all kept;
  // the user is excluded from matching (only `active` matches) and silently
  // reactivated to `active` on their next /start. Distinct from `paused`, which
  // is a deliberate in-menu toggle with a visible banner + manual Resume.
  frozen
  suspended
  pending_investigation
  banned
}

enum Language {
  en
  ru
  uk
  de
  pl
}

/// User-selected app color theme, applied across the Mini Apps and the
/// server-rendered match / date cards. `dark` is the brand default.
enum Theme {
  light
  dark
}

enum OnboardingStep {
  consent
  language
  conversational
  completed
}

enum AiMemoryExportPreference {
  undecided
  accepted
  declined
}

enum Gender {
  male
  female
}

enum GenderPreference {
  men
  women
  both
}

enum Platform {
  telegram
  mobile
  both
}

enum VerificationStatus {
  unverified
  pending
  /// Liveness passed at Persona but the face-match pipeline produced an
  /// inconclusive score (in [REVIEW, VERIFY) — see env.FACE_MATCH_THRESHOLD_*).
  /// Admin moderates these in the dashboard; users stay on `active` status
  /// (they can browse, but appear with a "review" badge to potential
  /// matches and accrue the unverified Elo penalty until cleared).
  pending_review
  verified
  rejected
}

enum MatchRadius {
  campus_only
  citywide
}

/// Priority bucket for a Profiler question. Drives both the order questions
/// are asked in (high first) and the weight their answer carries when fueling
/// icebreakers/hints (see `PROFILER_PRIORITY_WEIGHTS` in @gennety/shared).
enum ProfilerPriority {
  high
  medium
  low
}

model User {
  id                         String                   @id @default(uuid()) @db.Uuid
  telegramId                 BigInt                   @unique @map("telegram_id")
  /// Public Telegram username (without @), captured opportunistically from
  /// `ctx.from.username`. Used to build `t.me/<username>` deep links for the
  /// pre-date coordination contact-exchange variants — Telegram never issues
  /// a phone number to bots, so this is the only reliable contact handle.
  telegramUsername           String?                  @map("telegram_username")
  email                      String?                  @unique
  universityDomain           String?                  @map("university_domain")
  firstName                  String?                  @map("first_name")
  surname                    String?
  age                        Int?
  gender                     Gender?
  preference                 GenderPreference?
  major                      String?
  language                   Language?
  /// User-selected app color theme (Mini Apps + rendered cards). Defaults to
  /// `dark` (brand default); chosen in onboarding and changeable in Settings.
  theme                      Theme                    @default(dark)
  /// Set the first time the user explicitly picks a theme (onboarding theme
  /// screen or Settings). Distinguishes an explicit choice from the `dark`
  /// default, so the onboarding theme picker is shown exactly once.
  themeChosenAt              DateTime?                @map("theme_chosen_at")
  status                     UserStatus               @default(onboarding)
  onboardingStep             OnboardingStep           @default(consent) @map("onboarding_step")
  /// Whether the user wants to enrich onboarding with memory exported from
  /// their existing AI assistant. `declined` skips the Magic Prompt for this
  /// onboarding run and uses a deterministic fallback profile analysis.
  aiMemoryExportPreference   AiMemoryExportPreference @default(undecided) @map("ai_memory_export_preference")
  aiMemoryExportPreferenceAt DateTime?                @map("ai_memory_export_preference_at")
  hasConsented               Boolean                  @default(false) @map("has_consented")
  consentedAt                DateTime?                @map("consented_at")
  /// Explicit Terms of Service acceptance from the Initialization & Consent
  /// screen. Distinct from `hasConsented` (broader onboarding gate) — this
  /// is the legal ToS click and MUST be true to leave the `consent` step.
  termsAccepted              Boolean                  @default(false) @map("terms_accepted")
  termsAcceptedAt            DateTime?                @map("terms_accepted_at")
  /// Which version of the Terms + Privacy Policy the user actually accepted
  /// (`LEGAL_DOCS_VERSION` at the moment of the click). GDPR Art. 7(1) requires
  /// demonstrating WHAT was agreed to; a timestamp alone cannot, once the
  /// documents change. Null for consents recorded before 2026-08-01.
  policyVersion              String?                  @map("policy_version")
  /// Explicit consent to biometric processing (GDPR Art. 9(2)(a)), captured on
  /// its own screen before a liveness session is ever minted. Separate from
  /// `termsAccepted` on purpose: Art. 9 requires an explicit act for THIS
  /// processing specifically, and a general ToS tick is not one. The version
  /// records which disclosure text was shown. Null = never consented, which
  /// the liveness `/init` routes refuse.
  biometricConsentAt         DateTime?                @map("biometric_consent_at")
  biometricConsentVersion    String?                  @map("biometric_consent_version")
  /// User opt-in to anonymized research / analytics use of their data.
  /// Defaults to false (opt-in, never opt-out) per GDPR norms.
  researchOptIn              Boolean                  @default(false) @map("research_opt_in")
  /// Consent for the Dating Scratch Map (PRODUCT_SPEC §Living Canvas). Default
  /// FALSE and deliberately its own column rather than a fold into
  /// `researchOptIn`: that one governs analytics use of data the product
  /// already holds, while this one authorises COLLECTING a new class of it —
  /// where the user has physically been. Same rule, same reason, as
  /// `biometricConsentAt` above: a consent that authorises new collection is
  /// never inferred from a broader tick.
  ///
  /// Even with it on, nothing is written from the background: a tile is
  /// recorded only when the user themselves has the map open (a foreground
  /// ping) or when a Date Bump is verified at a venue, and what is stored is
  /// a geohash-6 tile (~1.2 km), never a raw coordinate.
  scratchMapOptIn            Boolean                  @default(false) @map("scratch_map_opt_in")
  emailOtp                   String?                  @map("email_otp")
  emailOtpExpiresAt          DateTime?                @map("email_otp_expires_at")
  /// True once the user has successfully verified an OTP for `email`.
  /// Set in two places: `findOrCreateMobileUser` (mobile API after
  /// `/v1/auth/otp/verify`) and `execVerifyOtp` in the onboarding agent
  /// (Telegram bot after the `verify_otp` tool succeeds). Read by the
  /// onboarding agent to skip the email-collection step entirely when a
  /// user arrives with their email already verified (e.g. mobile-first
  /// user later opens the Telegram bot, or restarts onboarding mid-flow).
  isEmailVerified            Boolean                  @default(false) @map("is_email_verified")
  /// Registration v2 (general track): phone captured via the Telegram Mini App
  /// one-tap `requestContact`. The bot receives a trusted `message.contact`
  /// (contact.user_id == from.id); client JS never sees the number. E.164.
  /// `@unique` = one account per number (curbs duplicate accounts).
  phone                      String?                  @unique
  /// Set when a trusted Telegram contact for THIS user is received. Phone
  /// equivalent of `isEmailVerified`; the general-track contact gate.
  phoneVerifiedAt            DateTime?                @map("phone_verified_at")
  /// Registration v2 track chosen at the sign-up fork: "student" (university
  /// email OTP) or "general" (phone). Null for users registered before the
  /// fork existed (legacy = student in practice: they all verified email).
  registrationTrack          String?                  @map("registration_track")
  messageHistory             Json[]                   @default([]) @map("message_history")
  lastMessageAt              DateTime?                @map("last_message_at")
  /// Last time the "your match is coming tomorrow" pre-batch teaser was sent.
  /// Prevents re-sending within the same weekly cycle.
  lastPreMatchAnnounceAt     DateTime?                @map("last_pre_match_announce_at")
  /// Onboarding re-engagement chain: how many touches have been delivered in
  /// the current drop-off streak (0 = chain idle, 5 = fully exhausted).
  reEngagementStep           Int                      @default(0) @map("re_engagement_step")
  /// Scheduled moment of the next re-engagement touch. Null = chain inactive
  /// (either user is still engaged, onboarding complete, or chain exhausted).
  reEngagementNextAt         DateTime?                @map("re_engagement_next_at")
  /// Accumulated Tier 2 strikes from verified reports.
  /// 1 → warning; 2 → 14-day suspension; ≥3 → ban.
  strikes                    Int                      @default(0)
  /// When a `suspended` status should auto-revert to `active`.
  /// Consumed by the match-engine tick; null for all non-suspended users.
  suspendedUntil             DateTime?                @map("suspended_until")
  /// Telegram `message_id` of the pinned "next match in …" status banner.
  /// Null = no banner pinned (either pre-finalize, or user unpinned / deleted).
  /// Cleared by the status-timer worker on 400/403 edit failures.
  statusMessageId            Int?                     @map("status_message_id")
  /// Identity origin. Mobile-first users are created with a synthetic negative
  /// `telegramId` (Telegram never issues negative IDs) — Telegram-targeting
  /// workers MUST filter `telegramId: { gt: 0 }` or `platform: { in: [telegram, both] }`.
  platform                   Platform                 @default(telegram)
  /// Expo / APNs / FCM push token registered by the mobile app.
  pushToken                  String?                  @map("push_token")
  pushPlatform               String?                  @map("push_platform")
  /// Liveness verification state (Phase 6.3 of the product spec).
  /// Backed by Persona hosted flow (withpersona.com) for both mobile and bot.
  verificationStatus         VerificationStatus       @default(unverified) @map("verification_status")
  /// Legacy mobile-side selfie path from the pre-Persona era. No new code
  /// writes here; kept as nullable for historical rows. Safe to drop later.
  selfiePath                 String?                  @map("selfie_path")
  /// Persona `inquiry` id captured from webhook events. Idempotent marker so
  /// retries don't double-process the same inquiry; also used to cross-link
  /// the Persona dashboard audit trail.
  personaInquiryId           String?                  @unique @map("persona_inquiry_id")
  /// The AWS Face Liveness session THIS user most recently minted, written at
  /// `beginLivenessCheck` and cleared when the check reaches a terminal state.
  ///
  /// Deliberately separate from `personaInquiryId`, which means "the session
  /// that produced the stored reference selfie" — `triggerVerificationRerun`
  /// reruns against that value, so a not-yet-completed session must never land
  /// there. This column exists purely so `completeLivenessCheck` can refuse a
  /// `sessionId` the caller did not create: the client reports only "I
  /// finished", and without the binding it could report any session id.
  pendingLivenessSessionId   String?                  @map("pending_liveness_session_id")
  /// Timestamp the inquiry flipped this user to `verified`. Re-verifications
  /// overwrite.
  verifiedAt                 DateTime?                @map("verified_at")
  /// Timestamp the user explicitly tapped "Skip" on the verification CTA at
  /// the end of onboarding. Mutually exclusive with `verifiedAt` — a later
  /// successful Persona run clears this. Drives the unverified-Elo penalty
  /// applied at decision time and surfaces in the admin dashboard.
  verificationSkippedAt      DateTime?                @map("verification_skipped_at")
  /// Supabase Storage path (in env.SUPABASE_SELFIE_BUCKET) of the selfie
  /// Persona captured during liveness. Set by the verification pipeline
  /// after a successful `inquiry.approved` event; used as the ground-truth
  /// reference for face-matching against profile photos (initial pass and
  /// any future photo edits). Auto-deleted by the retention worker 90 days
  /// after `verifiedAt` — the storage path is null thereafter even though
  /// the user remains `verified`. Re-verifications (or photo edits past the
  /// 90-day window) re-fetch ephemerally from Persona via `personaInquiryId`
  /// and fail closed if no authoritative reference is available.
  verifiedSelfiePath         String?                  @map("verified_selfie_path")
  /// Minimum face-match similarity (0..1) across all profile photos, taken
  /// against `verifiedSelfiePath`. Below `env.FACE_MATCH_THRESHOLD_VERIFY`
  /// → `pending_review` or `rejected`. Null on legacy verified users (the
  /// migration explicitly opts them out of retroactive face-matching — see
  /// admin dashboard for the manual re-trigger).
  faceMatchScore             Float?                   @map("face_match_score")
  /// Timestamp of the most recent face-match pass. Distinct from
  /// `verifiedAt` (which only flips on the first successful liveness pass)
  /// — `faceMatchedAt` updates on every photo upload past the initial run.
  faceMatchedAt              DateTime?                @map("face_matched_at")
  /// First-touch attribution captured once on user creation. Format is
  /// free-form (`tg:start_param`, `mobile:utm=ig_story`, `referral:USER_ID`)
  /// — the analytics layer parses prefixes. Never overwritten after the
  /// initial write so growth attribution stays stable across re-onboarding.
  referralSource             String?                  @map("referral_source")
  /// Materialized ticket wallet balance (Date Ticket monetization, gated by
  /// `TICKET_FEATURE_ENABLED`). A ticket is spent at the §3.5b date gate; it
  /// is topped up by bundle purchases (the store Mini App) and one-time
  /// onboarding bonuses (6+ profile photos, adding a profile video). This is
  /// the materialized counter — every change is written atomically alongside a
  /// `TicketLedger` audit row in the same transaction, so the ledger is the
  /// append-only source of truth and this column is its running sum.
  ticketBalance              Int                      @default(0) @map("ticket_balance")
  /// One-time "famine" single-ticket discount (Date Ticket monetization, gated
  /// by `TICKET_FEATURE_ENABLED`). Granted when the user is eligible-but-unpaired
  /// for a 2nd consecutive weekly batch (no-match tier >= 2). It discounts a
  /// SINGLE ticket purchase — the date gate's `self` scope and the store's
  /// "1 ticket" bundle — and is consumed on the first such purchase. See
  /// PRODUCT_SPEC.md §3.5b and `services/ticket-discount.ts`.
  /// Active ⇔ `ticketDiscountPct > 0 AND ticketDiscountConsumedAt IS NULL AND
  /// ticketDiscountExpiresAt > now`. `0`/nulls = no active discount.
  ticketDiscountPct          Int                      @default(0) @map("ticket_discount_pct")
  ticketDiscountGrantedAt    DateTime?                @map("ticket_discount_granted_at")
  ticketDiscountExpiresAt    DateTime?                @map("ticket_discount_expires_at")
  ticketDiscountConsumedAt   DateTime?                @map("ticket_discount_consumed_at")
  /// Gennety Premium subscription (gated by `PREMIUM_FEATURE_ENABLED`).
  /// Channel-agnostic per-user entitlement owned by `services/premium.ts`; the
  /// `subscription_ledger` is the append-only source of truth and these columns
  /// are its materialized head. Active ⇔ `premiumUntil > now`. First benefit is
  /// the venue-change premium-venue unlock + change-fee waiver (PRODUCT_SPEC
  /// §Premium). `premiumProvider` ∈ `telegram_stars`/`app_store`;
  /// `premiumExternalId` is the recurring anchor (Stars subscription charge id
  /// or App Store `originalTransactionId`) used to reconcile renewals/cancels.
  premiumUntil               DateTime?                @map("premium_until")
  premiumSince               DateTime?                @map("premium_since")
  premiumProvider            String?                  @map("premium_provider")
  premiumAutoRenew           Boolean                  @default(false) @map("premium_auto_renew")
  premiumExternalId          String?                  @map("premium_external_id")
  /// Expiry-reminder once-markers (PRODUCT_SPEC §3.8 → "Access is not silently
  /// lost"). The 3-day and 24-hour DMs are sent at most once per PAID PERIOD,
  /// so every path that advances `premiumUntil` clears both — otherwise a user
  /// who renews is reminded once and then never again. Only ever set for a
  /// non-auto-renewing entitlement: nothing is ending while Telegram or Apple
  /// is still charging, and a "your access is running out" DM to a live
  /// subscriber would be false.
  premiumReminder3dAt        DateTime?                @map("premium_reminder_3d_at")
  premiumReminder1dAt        DateTime?                @map("premium_reminder_1d_at")
  /// Referral program (gated by `REFERRAL_FEATURE_ENABLED`; PRODUCT_SPEC
  /// §Referral). `referralVerifiedCount` is the referrer's materialized tally of
  /// invited friends who cleared verification — the milestone-ladder progress,
  /// read by the referral Mini App. `referralCountedAt` is the INVITEE-side
  /// once-marker (CAS null→now) proving this user was already counted toward
  /// their referrer, so the ladder can never double-count. `referralInviteePremiumAt`
  /// is the INVITEE-side once-marker for the 1-month welcome-Premium gift shown
  /// on the onboarding wow screen. Rewards themselves live in `ticket_ledger`
  /// (`referral_milestone`) and `subscription_ledger` (`referral`).
  referralVerifiedCount      Int                      @default(0) @map("referral_verified_count")
  referralCountedAt          DateTime?                @map("referral_counted_at")
  referralInviteePremiumAt   DateTime?                @map("referral_invitee_premium_at")
  /// Promo-code program (gated by `PROMO_FEATURE_ENABLED`; see
  /// PROMO_CODES_PRODUCT_SPEC.md). Independent campaign codes (not tied to a
  /// referrer) that grant a new user a Date Ticket + Premium months at the
  /// onboarding wow screen. Attribution reuses `referralSource` as
  /// `promo:<CODE>` (mutually exclusive with `referral:*`). `promoRedeemedAt`
  /// is the once-marker for the wow screen + grant guard; the reward itself is
  /// recorded exactly-once in `PromoRedemption` + `ticket_ledger` (`promo`) +
  /// `subscription_ledger` (`promo`).
  promoRedeemedAt            DateTime?                @map("promo_redeemed_at")
  /// Founder-notify (gated by `FOUNDER_NOTIFY_ENABLED`): stamped the first time
  /// this user becomes `active` and the "new registration" profile card is sent
  /// to the founder's personal Telegram. Idempotency marker — the notifier
  /// updates it with `where: { founderNotifiedAt: null }`, so re-activation
  /// (verified-after-skip, unfreeze on `/start`) never re-sends. Null = never
  /// notified.
  founderNotifiedAt          DateTime?                @map("founder_notified_at")
  /// Non-null on a SYNTHETIC test profile — a hand-seeded account that exists
  /// only to balance the gender skew in a friends-and-family production test
  /// (PRODUCT_SPEC §3.1c). It is an ordinary `User` + `Profile` in every other
  /// respect, which is the point: the pitch generator, the card renderers and
  /// the decision flow read it exactly as they read a person.
  ///
  /// Two things the column gates, and both are load-bearing:
  ///   - **Admission.** `buildCandidateSql` excludes it unconditionally, so the
  ///     single-seeker engine (paid Rematch, the D10 auto-resume probe) can
  ///     never surface one. Only the drop batch's second "fill" pass opts them
  ///     in, and only for users the real pool left unpaired.
  ///   - **Neutrality.** A synthetic partner declines 100% of the time by
  ///     construction, so its verdict carries no information: `updateEloScores`
  ///     no-ops on such a pair, and the real side's `standbyCount` is neither
  ///     reset nor incremented. Without that, a week of test matches would walk
  ///     a real friend's rating down `V_league` on contests that never happened.
  ///
  /// Seeded and removed by `scripts/seed-synthetic-profiles.mjs`. Null on every
  /// real account, so the whole mechanism is inert until a row carries it.
  syntheticAt                DateTime?                @map("synthetic_at")
  createdAt                  DateTime                 @default(now()) @map("created_at")
  updatedAt                  DateTime                 @updatedAt @map("updated_at")

  profile                   Profile?
  onboardingProgress        OnboardingProgress?
  onboardingStepEvents      OnboardingStepEvent[]
  sessions                  UserSession[]
  clientEvents              ClientEvent[]
  profilerAnswers           ProfilerAnswer[]
  voicePrompt               VoicePrompt?
  scratchMap                UserScratchMap?
  ticketLedger              TicketLedger[]
  subscriptionLedger        SubscriptionLedger[]
  rematchPurchases          RematchPurchase[]
  venueChangePurchases      VenueChangePurchase[]
  liveActivityTokens        LiveActivityToken[]
  mediaValidationRejections MediaValidationRejection[]
  chatEvents                ChatEvent[]

  matchesAsA          Match[]      @relation("MatchUserA")
  matchesAsB          Match[]      @relation("MatchUserB")
  matchEventsAuthored MatchEvent[] @relation("MatchEventActor")
  matchEventsTargeted MatchEvent[] @relation("MatchEventTarget")

  reportsFiled   Report[] @relation("ReportReporter")
  reportsAgainst Report[] @relation("ReportReported")

  blocksFiled   UserBlock[] @relation("UserBlockBlocker")
  blocksAgainst UserBlock[] @relation("UserBlockBlocked")

  messages Message[]

  noMatchNotices NoMatchNotice[]

  promoRedemption PromoRedemption?

  @@index([status, reEngagementNextAt])
  @@index([status, suspendedUntil])
  /// The premium expiry-reminder sweep runs hourly and asks one question of the
  /// whole table: whose paid period lands in the next three days. Without this
  /// it is a sequential scan every hour, for a column that is null on the
  /// overwhelming majority of rows.
  @@index([premiumUntil])
  @@map("users")
}

/// Independent promo-code campaign (gated by `PROMO_FEATURE_ENABLED`; see
/// PROMO_CODES_PRODUCT_SPEC.md). ONE reusable code per campaign, shared in ad
/// materials, that grants a new user a Date Ticket + Premium months at the
/// onboarding wow screen. `redeemedCount` is the materialized running tally of
/// `PromoRedemption` rows (both written in one transaction), capped by
/// `maxRedemptions` (null = unlimited). Managed out-of-band by
/// `scripts/promo-codes.mjs`.
model PromoCode {
  id             String    @id @default(uuid()) @db.Uuid
  /// The campaign code, stored uppercased (matched case-insensitively).
  code           String    @unique
  /// Per-code reward (launch defaults 1 ticket / 3 months of Premium).
  ticketReward   Int       @default(1) @map("ticket_reward")
  premiumMonths  Int       @default(3) @map("premium_months")
  /// Activation cap; null = unlimited. `redeemedCount` never exceeds it.
  maxRedemptions Int?      @map("max_redemptions")
  redeemedCount  Int       @default(0) @map("redeemed_count")
  expiresAt      DateTime? @map("expires_at")
  active         Boolean   @default(true)
  /// Internal campaign label (not user-facing).
  note           String?
  createdAt      DateTime  @default(now()) @map("created_at")

  redemptions PromoRedemption[]

  @@map("promo_codes")
}

/// One-per-user record that a promo code was redeemed (gated by
/// `PROMO_FEATURE_ENABLED`). The unique `userId` enforces first-touch,
/// one-code-per-human; `@@unique([promoCodeId, userId])` plus the same-tx
/// `PromoCode.redeemedCount++` makes the grant exactly-once and cap-safe under
/// concurrency. Reward deltas live in the ledgers; this is the audit + guard.
model PromoRedemption {
  id             String   @id @default(uuid()) @db.Uuid
  promoCodeId    String   @map("promo_code_id") @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  ticketsApplied Int      @map("tickets_applied")
  monthsApplied  Int      @map("months_applied")
  redeemedAt     DateTime @default(now()) @map("redeemed_at")

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, userId])
  @@index([promoCodeId, redeemedAt])
  @@map("promo_redemptions")
}

/// Append-only audit log of every ticket-wallet movement (Date Ticket
/// monetization, gated by `TICKET_FEATURE_ENABLED`). The running sum of
/// `delta` equals `User.ticketBalance`, which is materialized for fast reads;
/// both are written in the same transaction by `services/ticket-wallet.ts`.
///
/// `reason` (string, validated in app code — not a Prisma enum):
///   photo_bonus    — +1 one-time bonus for reaching 6+ profile photos
///   video_bonus    — +1 one-time bonus for adding a profile video
///   verification_bonus — +1 one-time bonus for successful identity verification
///   store_purchase — +N from a bundle purchase in the store Mini App
///   spend_match    — -1 (or -2) consumed at the §3.5b date gate
///   refund         — +N wallet reversal (e.g. an expired/refunded match ticket)
///   gate_payment / gate_processing / gate_settled — atomic Stars settlement
///   gate_surplus_pending — durable pending wallet credit for partial overpay
///   gate_refund_pending / gate_refunded — durable Stars refund state
model TicketLedger {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  /// Signed change applied to the balance (+ grants/purchases, - spends).
  delta             Int
  reason            String
  /// Set for `spend_match`/`refund` rows so a movement can be traced to the
  /// match it paid for. Free-form (no FK) so deleting a match never breaks the
  /// audit trail.
  matchId           String?  @map("match_id") @db.Uuid
  /// Money attached to a purchase row (cents) — null for free bonuses/spends.
  amountCents       Int?     @map("amount_cents")
  /// Telegram Stars charged, frozen at purchase time. Star prices are
  /// env-tunable (`TICKET_BUNDLE_STARS`), so a paid row must carry what was
  /// actually charged rather than let a reader re-derive today's price from
  /// `bundleSize` — the same rule `RematchPurchase`/`VenueChangePurchase`
  /// already follow. Null for free bonuses/spends and for non-Stars rails
  /// (App Store rows carry `amountCents` instead).
  amountStars       Int?     @map("amount_stars")
  /// Bundle size for `store_purchase` rows (1 / 3 / 6).
  bundleSize        Int?     @map("bundle_size")
  /// Unique provider charge id (Telegram Stars `telegram_payment_charge_id`)
  /// set on paid store purchases and date-gate Stars payments. Its unique
  /// constraint makes Telegram redelivery exactly-once and preserves the charge
  /// id required for later expiry refunds. Synthetic ids also dedupe wallet
  /// reversals and surplus credits.
  externalPaymentId String?  @unique @map("external_payment_id")
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ticket_ledger")
}

/// Append-only audit of every Gennety Premium subscription movement (gated by
/// `PREMIUM_FEATURE_ENABLED`). Mirrors `ticket_ledger`: the unique
/// `externalPaymentId` (Telegram Stars recurring charge id, or an App Store
/// notification/transaction id) makes provider redelivery exactly-once, so a
/// renewal is applied at most once. `User.premiumUntil`/`premiumSince` are the
/// materialized head of this log. Owned by `services/premium.ts`. See
/// PRODUCT_SPEC.md §Premium.
model SubscriptionLedger {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  /// `telegram_stars` | `app_store`.
  provider          String
  /// `started` | `renewed` | `cancelled` | `expired` | `refunded`.
  event             String
  /// Unique provider charge/notification id → exactly-once application.
  externalPaymentId String?   @unique @map("external_payment_id")
  /// Subscription period this movement covers (informational/audit).
  periodStart       DateTime? @map("period_start")
  periodEnd         DateTime? @map("period_end")
  /// Charged amount in the provider's smallest unit (Stars = whole XTR; App
  /// Store = the product's price). Null for non-charge events.
  amount            Int?
  /// `XTR` for Telegram Stars; ISO currency for App Store rows. Null for
  /// non-charge events.
  currency          String?
  /// Free-text churn reason captured after an in-chat cancellation (the menu
  /// agent's cancel flow). Only ever set on `cancelled` rows; null otherwise.
  note              String?
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("subscription_ledger")
}

/// Append-only audit of every paid Rematch purchase (gated by
/// `REMATCH_FEATURE_ENABLED`). See REMATCH_PRODUCT_SPEC.md.
///
/// Mirrors `ticket_ledger`/`subscription_ledger`: the unique
/// `externalPaymentId` (Telegram Stars `telegram_payment_charge_id`) makes a
/// redelivered `successful_payment` exactly-once AND preserves the charge key
/// `refundStarPayment` needs later. There is no materialized head on `User` —
/// the D3 rate limits are derived from these rows, so there is no counter to
/// drift out of sync with the money.
///
/// Rows are written ONLY from the `successful_payment` trust boundary: a row
/// exists ⇔ Stars actually moved. Every row therefore ends in a terminal state
/// where the user either got a match or got their Stars back.
model RematchPurchase {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  /// `processing`          — Stars moved; the row is written BEFORE the engine
  ///                         runs so a crash mid-run still leaves a durable
  ///                         record that money was taken. The hourly worker
  ///                         refunds rows stuck here (mirrors how an abandoned
  ///                         `gate_payment` ticket row is swept).
  /// `settled`             — a match was created and dispatched.
  /// `refunded_no_candidate` — the engine found nobody; Stars returned (D1).
  /// `refunded_ineligible` — eligibility/limits failed at settle; Stars returned.
  /// `refund_failed`       — the refund API call failed; the hourly retry worker
  ///                         owns this row until it flips to a refunded state.
  status            String
  /// Unique Telegram Stars charge id → exactly-once settle + refund key.
  externalPaymentId String    @unique @map("external_payment_id")
  /// Price frozen at purchase time (prices are env-tunable, so the row must not
  /// re-derive them later).
  amountStars       Int       @map("amount_stars")
  amountCents       Int?      @map("amount_cents")
  /// The delivered match, when `settled`. Free-form (no FK) so deleting a match
  /// never breaks the payment audit trail.
  resultMatchId     String?   @map("result_match_id") @db.Uuid
  /// Which gift framing the partner's pitch used (`famine`/`failed`/`neutral`) —
  /// kept for copy A/B. Never contains her identity or any decision state.
  framing           String?
  /// Terminal-state stamp + last refund error (retry bookkeeping).
  resolvedAt        DateTime? @map("resolved_at")
  refundError       String?   @map("refund_error")
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Backs the D3 rolling-window limit + cooldown lookup.
  @@index([userId, createdAt])
  /// Backs the hourly `refund_failed` retry sweep.
  @@index([status, createdAt])
  @@map("rematch_purchases")
}

/// Append-only audit of every paid §3.7b venue change (gated by
/// `VENUE_CHANGE_FEATURE_ENABLED`). Mirrors `rematch_purchases`, and for the
/// same reason: a venue change is a one-off purchase, not a wallet movement, so
/// it does not belong in `ticket_ledger`.
///
/// The row is written BEFORE the agreed→settled CAS, so a crash between
/// "Telegram confirmed the Stars moved" and the settle still leaves a durable
/// record that money was taken — which the hourly sweep then refunds. The
/// unique `externalPaymentId` is what distinguishes a redelivered
/// `successful_payment` (P2002 ⇒ idempotent no-op) from a genuinely second
/// charge (insert succeeds ⇒ must be refunded). Before this table existed both
/// looked identical and the second charge was silently kept.
model VenueChangePurchase {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  /// The match whose venue swap this paid for. Free-form (no FK) so deleting a
  /// match never breaks the payment audit trail — same rule as
  /// `RematchPurchase.resultMatchId` / `TicketLedger.matchId`.
  matchId           String    @map("match_id") @db.Uuid
  /// `processing`     — Stars moved; written before the settle CAS. Rows stuck
  ///                    here past `VENUE_PROCESSING_STALE_MS` are refunded by
  ///                    the hourly sweep.
  /// `settled`        — the swap was claimed and both sides notified.
  /// `refunded_race`  — a parallel-pay race lost the CAS; Stars returned.
  /// `refunded_stale` — abandoned mid-settle; Stars returned by the sweep.
  /// `refund_failed`  — the refund API call failed; the sweep owns this row
  ///                    until it flips to a refunded state. NEVER announced to
  ///                    the user as a completed refund.
  status            String
  /// Unique Telegram Stars charge id → exactly-once settle + the key
  /// `refundStarPayment` needs later.
  externalPaymentId String    @unique @map("external_payment_id")
  /// Price frozen at purchase time (`VENUE_CHANGE_STARS` is env-tunable, so the
  /// row must not re-derive it later).
  amountStars       Int       @map("amount_stars")
  resolvedAt        DateTime? @map("resolved_at")
  refundError       String?   @map("refund_error")
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  /// Backs the hourly `processing` / `refund_failed` sweep.
  @@index([status, createdAt])
  @@map("venue_change_purchases")
}

model OnboardingProgress {
  userId           String    @id @map("user_id") @db.Uuid
  completedFields  String[]  @default([]) @map("completed_fields")
  skippedFields    String[]  @default([]) @map("skipped_fields")
  askedFields      String[]  @default([]) @map("asked_fields")
  currentQuestion  String?   @map("current_question")
  collectorVersion Int       @default(1) @map("collector_version")
  revision         Int       @default(0)
  backfilledAt     DateTime? @map("backfilled_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("onboarding_progress")
}

/// Append-only onboarding funnel telemetry: one row per step transition.
/// `kind = asked` when a step is first surfaced to the user; `answered` /
/// `skipped` when they resolve it (advancing to the next step). `dwellMs` on
/// an `answered`/`skipped` row is the wall-clock gap since that step's matching
/// `asked` row — i.e. how long the user hesitated on that step. Drop-off is
/// derived, not stored: a still-`onboarding` user whose latest `asked` step has
/// no matching `answered`/`skipped` is stuck there. Feeds the
/// `/admin/analytics/onboarding-funnel` endpoint (drop-off %, dwell median/p90,
/// abandonment hotspots). Written from the onboarding collector's existing
/// persistence transaction (`services/onboarding-analytics.ts`); never mines
/// personal answers — only the step key, its outcome, and timing.
model OnboardingStepEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// Step key: an `ONBOARDING_QUESTIONS` value (first_name_age, gender, …,
  /// photos), the trailing `verification` CTA, or a Mini-App macro step
  /// (consent/language/city/theme/ai_memory).
  step      String
  /// `asked` | `answered` | `skipped`.
  kind      String
  /// ms hesitated on this step (now − matching `asked`); null on `asked` rows
  /// and when no matching `asked` was found.
  dwellMs   Int?     @map("dwell_ms")
  language  String?
  platform  String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([step, kind, createdAt])
  @@map("onboarding_step_events")
}

/// Append-only timeline of what actually happened in a user's Telegram chat:
/// every durable message the bot SENT (`direction = out`) and every action the
/// user TOOK (`direction = in`) — typed text, a voice note's transcript, a
/// button tap, a Mini App submission, a settled payment.
///
/// It exists because the menu agent could not see its own product. Outbound
/// messages are written from ~276 scattered call sites (`api.sendMessage` /
/// `ctx.reply`) while `User.messageHistory` only ever held the agent's OWN
/// turns, so a user answering "why?" right under a bot message was answered
/// against conversation from days earlier. The rows are written by a single
/// grammY API transformer (`services/outbound-recorder.ts`) plus one inbound
/// middleware (`handlers/interaction-recorder.ts`), and read back by
/// `services/prompt-builder.ts` as the agent's "Recent chat timeline".
///
/// Deliberately NOT a second copy of the conversation: `summary` is truncated,
/// only post-onboarding users are recorded (which keeps OTP codes, phone
/// numbers and AI-memory pastes out by construction), ephemeral status
/// shimmers and per-minute banner/countdown re-renders are skipped, and rows
/// are swept after 30 days by `workers/retention.ts`.
model ChatEvent {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  /// `out` = the bot sent it; `in` = the user did it.
  direction         String
  /// Form of the event, so the agent knows a PNG card from a plain message:
  /// `text` | `photo` | `album` | `video` | `video_note` | `voice` | `document`
  /// | `user_text` | `user_voice` | `user_media` | `user_contact`
  /// | `callback_tap` | `mini_app_action` | `payment`.
  kind              String
  /// Coarse product area derived from callback prefixes / Mini App page /
  /// route (`venue_change`, `match`, `calendar`, `ticket`, `menu`, …).
  /// Null when nothing identifiable was attached.
  surface           String?
  /// Human-readable one-liner: the message text or caption, the tapped
  /// button's own label, or the Mini App action. Truncated — never the full
  /// body, never media bytes.
  summary           String
  /// Buttons that were offered on an outbound message: `[{ label, data?,
  /// webApp? }]`. This is what lets the agent answer "what do I tap".
  actions           Json?
  /// Displayable media attached to the event: `[{ kind, ref }]`, where `ref`
  /// is a Telegram `file_id` the admin media proxy can re-download. Never the
  /// bytes. Without this a photo, an album or a video note is recorded as the
  /// bare string "(photo card, no caption)" and the admin transcript can only
  /// say that something visual happened, never show it.
  media             Json?
  /// Telegram message id, when the event has one. Used to reconcile a
  /// `deleteMessage` back to the row it created.
  telegramMessageId Int?     @map("telegram_message_id")
  /// Free-form, no FK (mirrors `rematch_purchases`) so deleting a match never
  /// breaks the timeline.
  matchId           String?  @map("match_id")
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Backs the "last N events for this user" read on every agent turn.
  @@index([userId, createdAt])
  /// Backs the `deleteMessage` reconciliation lookup.
  @@index([telegramMessageId])
  @@map("chat_events")
}

model Profile {
  id                        String                       @id @default(uuid()) @db.Uuid
  userId                    String                       @unique @map("user_id") @db.Uuid
  height                    Int?
  hobbies                   String[]                     @default([])
  partnerPreferences        String?                      @map("partner_preferences")
  psychologicalSummary      String?                      @map("psychological_summary")
  negativeConstraints       String?                      @map("negative_constraints")
  ageRangeMin               Int?                         @map("age_range_min")
  ageRangeMax               Int?                         @map("age_range_max")
  embedding                 Unsupported("vector(1536)")?
  /// M-2: dirty flag set by any code path that mutates a field which feeds
  /// the embedding (psychologicalSummary, partnerPreferences,
  /// negativeConstraints, hobbies). The `embedding-refresh` background
  /// worker picks dirty rows up every few minutes, recomputes via OpenAI,
  /// and clears the flag. Pre-M-2 the embedding silently went stale every
  /// time a user edited their profile, degrading match quality forever.
  embeddingDirty            Boolean                      @default(false) @map("embedding_dirty")
  embeddingDirtyAt          DateTime?                    @map("embedding_dirty_at")
  /// Universal Elo rating in [0..1000]. Seeded by the AI vision pass on the
  /// primary photo when Persona flips the user to `verified`
  /// (see `apps/bot/src/services/elo/seed-from-vision.ts`), then updated on
  /// each Thursday accept/decline event (see `apps/bot/src/utils/elo-calculator.ts`).
  /// Drives the `V_league` multiplier in match scoring — large rating gaps
  /// decay the candidate's score so users mostly see opponents in their league.
  eloScore                  Int                          @default(500) @map("elo_score")
  /// Lifetime count of resolved match events used to drive the dynamic K-factor:
  /// K=20 while < 10 (fast calibration), K=10 thereafter. Half the textbook
  /// chess defaults so the photo-derived cold-start seed dominates and
  /// behavioral updates remain a secondary refinement.
  eloMatchesPlayed          Int                          @default(0) @map("elo_matches_played")
  /// Reliability — how dependably this person turns up, +`BUMP_RELIABILITY_REWARD`
  /// per Date Bump verified at the venue (PRODUCT_SPEC §Date Bump).
  ///
  /// Deliberately NOT folded into `eloScore` above, even though the spec calls
  /// the reward "рейтинг надёжности (Elo)". That column is *attractiveness*:
  /// seeded by a vision pass over the photos and moved by accept/decline, and
  /// it drives `V_league`, which decides who is a viable candidate at all.
  /// Writing an attendance reward into it would mean a person who shows up
  /// reliably is scored as better-looking, and would corrupt the one signal
  /// the league gate reads. Two different facts about a person need two
  /// columns; "reliability" is the literal meaning of the spec's own phrase.
  ///
  /// Not read by the matching engine today — it accumulates first, exactly as
  /// `socialRole` does, so a weight can be chosen against real data instead of
  /// guessed. A future factor belongs beside `V_type`/`V_intent` in §3.2, not
  /// inside `V_league`.
  reliabilityScore          Int                          @default(0) @map("reliability_score")
  /// Idempotency marker: timestamp the cold-start AI vision pass seeded
  /// `eloScore`. Persona webhook retries skip the OpenAI call when set.
  /// Null on legacy rows and on users who haven't yet completed verification.
  eloSeededAt               DateTime?                    @map("elo_seeded_at")
  /// Raw vision-pass output stored alongside `eloSeededAt`: the SCUT-FBP5500-
  /// style sub-scores (symmetry, eye distance, face shape, feature regularity),
  /// the overall 0..100 score, the model name, and the mapped Elo. Lets ops
  /// answer "why did this user start at 720?" with a single SELECT instead of
  /// re-running the OpenAI call. Null for users seeded before the feature
  /// shipped or when the seeding flag was disabled.
  eloSeedDetails            Json?                        @map("elo_seed_details")
  photos                    String[]                     @default([])
  /// Structured profile media displayed in Telegram cards. This is
  /// deliberately additive: `photos[]` remains the ordered static-photo
  /// source for verification and fallback, while each `profile_media[]`
  /// item can carry richer Telegram media metadata, e.g.
  /// `{ type: "live_photo", photo: "<static file_id>", livePhoto: "<video file_id>" }`.
  /// Empty on legacy rows; callers normalize it from `photos[]`.
  profileMedia              Json[]                       @default([]) @map("profile_media")
  /// Provider-neutral upload-time identity anchor for onboarding/profile media.
  /// V1 stores non-secret anchor metadata for the first accepted photo while
  /// actual face comparison continues to use transient image bytes.
  referenceFaceEmbedding    Json?                        @map("reference_face_embedding")
  /// Perceptual hashes for accepted static photos, in upload order. Used for
  /// cheap duplicate rejection before moderation/face provider calls.
  uploadedPhotoHashes       String[]                     @default([]) @map("uploaded_photo_hashes")
  /// Static photos that passed per-photo safety/face/duplicate validation but
  /// have not yet formed a 2+ photo identity-consensus cluster. These are not
  /// rendered, counted toward MIN_PHOTOS, or used by matching/verification.
  pendingPhotoCandidates    Json[]                       @default([]) @map("pending_photo_candidates")
  /// Count of static photos accepted by upload-time validation. Videos are
  /// display-only and are not counted toward this value.
  acceptedPhotoCount        Int                          @default(0) @map("accepted_photo_count")
  /// Per-photo face-match similarity (0..1) against User.verifiedSelfiePath,
  /// ordered 1:1 with `photos[]`. Empty for unverified users and for
  /// pre-feature legacy rows. Populated by the verification pipeline on
  /// initial verify and by the photo-upload gate on every subsequent edit.
  /// Stored alongside `photos` (rather than computed on the fly) so the
  /// admin dashboard can spot the *specific* offending photo when a user
  /// lands in `pending_review`, instead of recomputing N Rekognition calls.
  photoFaceScores           Float[]                      @default([]) @map("photo_face_scores")
  /// Mobile-side match radius preference. Telegram users inherit the default.
  matchRadius               MatchRadius                  @default(campus_only) @map("match_radius")
  /// Persistent "home base" coordinates used by the Meet-Halfway matching
  /// algorithm to compute great-circle distance / midpoints between candidates.
  /// Distinct from `Match.vibeLat{A,B}` which are per-match commute pins set
  /// during venue negotiation. Nullable: a user may not have shared location
  /// yet (legacy rows, declined OS prompt). Updated via `POST /v1/me/location`.
  latitude                  Float?                       @map("latitude")
  longitude                 Float?                       @map("longitude")
  /// Freshness marker for the home coordinates. The matching engine can
  /// fall back to `matchRadius`-only scoring when this is stale or null.
  locationUpdatedAt         DateTime?                    @map("location_updated_at")
  /// Canonical dating city selected during onboarding. This is the hard
  /// local matching boundary: users can match across university domains only
  /// when they share the same `homeCityKey`.
  homeCity                  String?                      @map("home_city")
  homeCountryCode           String?                      @map("home_country_code")
  homeCityKey               String?                      @map("home_city_key")
  homePlaceId               String?                      @map("home_place_id")
  /// Last time this profile was included in a `Match` row. Used by the
  /// match-engine tick to avoid re-pairing the same user within a cooldown.
  lastMatchedAt             DateTime?                    @map("last_matched_at")
  /// Consecutive weekly batches where this profile was eligible but left
  /// unpaired, plus compensating boosts when the user accepted a proposal
  /// but the peer declined. Reset to 0 on a successful pairing. Read by the
  /// scoring function as a capped priority bonus (see `starvationBonus`).
  missedWeeks               Int                          @default(0) @map("missed_weeks")
  /// Canonical standby/starvation counter used by the premium "Standby Mode"
  /// UX. Incremented when a user is eligible for the weekly batch but left
  /// unmatched, or accepts a proposal but the peer declines; reset to 0 on a
  /// successful pairing.
  standbyCount              Int                          @default(0) @map("standby_count")
  /// Timestamp of the most recent batch/unresolved accepted-side outcome that
  /// boosted this profile. Drives the "priority boosted" UX ping.
  lastMissedAt              DateTime?                    @map("last_missed_at")
  /// Set when the system (not the user) paused matching for this profile
  /// because no candidate has existed for FAMINE_PAUSE_AFTER_DAYS days
  /// running (D10 — see `services/pool-exhaustion.ts`). Distinguishes a
  /// system-driven pause (`User.status = 'paused'` + this set) from an
  /// ordinary user-initiated pause via the menu (status = 'paused', this
  /// stays null) so the two can be told apart: only a system pause is ever
  /// auto-resumed once a candidate reappears; a user's own pause is never
  /// touched by that sweep. Cleared on any resume, manual or automatic.
  starvationPausedAt        DateTime?                    @map("starvation_paused_at")
  /// Number of times this profile silently let a match proposal expire
  /// (24h passed without Accept/Decline). Counted post-expiry by
  /// `expireStaleMatches`. Forgive-once gate: first offense = warning only,
  /// from the second onwards Elo is decremented as if the user had declined.
  silentIgnoreCount         Int                          @default(0) @map("silent_ignore_count")
  /// IANA timezone (e.g. "Europe/Kyiv") resolved from the user's dating city.
  /// Drives the Profiler's morning/evening batch windows in the user's local
  /// wall-clock time. Null → the scheduler falls back to Europe/Kyiv. Derived
  /// at city-selection time via `cityKeyToTimeZone` in @gennety/shared.
  timeZone                  String?                      @map("time_zone")
  /// Profiler (PRODUCT_SPEC §Phase 1b) scheduler state. The Profiler harvests
  /// gender-specific Q&A in timed batches after onboarding to fuel icebreakers
  /// and date-planning hints — it is NOT used by the matching algorithm.
  ///   - `profilerStartedAt`: seed marker; null = the post-onboarding entry
  ///     timer hasn't been armed yet (lazily seeded by the worker for legacy
  ///     rows, precisely at finalize for new completions).
  ///   - `profilerNextAt`: when the next batch's first question may be sent.
  ///     Null while a batch is in flight (driven by replies) or when every
  ///     question is answered.
  ///   - `profilerActiveQuestionId`: the question currently awaiting a reply;
  ///     null = not awaiting. Used by the answer/skip handler.
  ///   - `profilerBatchRemaining`: questions left to send in the current batch
  ///     before pausing to the next window.
  ///   - `profilerAnswerWindowUntil`: deadline for the *implicit* capture of
  ///     plain text as an answer to the active question. Set to
  ///     now + PROFILER_ANSWER_WINDOW_MS when a question is sent, and cleared
  ///     the moment the user does anything else (a command, a menu tap, another
  ///     flow) — after that the question is no longer the default addressee of
  ///     free text, which falls through to the menu agent instead. Distinct
  ///     from the much longer `profilerNextAt` stall deadline, which only
  ///     governs when the schedule re-opens.
  ///   - `profilerQuestionMessageId`: Telegram message id of the active
  ///     question. Lets an explicit reply-to be recognised as an answer even
  ///     after the implicit window closed, and lets the Skip keyboard be
  ///     stripped once the question stops being live.
  profilerStartedAt         DateTime?                    @map("profiler_started_at")
  profilerNextAt            DateTime?                    @map("profiler_next_at")
  profilerActiveQuestionId  String?                      @map("profiler_active_question_id")
  profilerBatchRemaining    Int                          @default(0) @map("profiler_batch_remaining")
  profilerAnswerWindowUntil DateTime?                    @map("profiler_answer_window_until")
  profilerQuestionMessageId Int?                         @map("profiler_question_message_id")
  /// One-time onboarding ticket-bonus idempotency markers (gated by
  /// `TICKET_FEATURE_ENABLED`). Set the first time the profile reaches 6+
  /// face-validated photos (`photoBonusTicketAt`) or gains a profile video
  /// (`videoBonusTicketAt`). The grant is never re-issued, even if the user
  /// later edits photos/video. See `services/ticket-wallet.ts`.
  photoBonusTicketAt        DateTime?                    @map("photo_bonus_ticket_at")
  videoBonusTicketAt        DateTime?                    @map("video_bonus_ticket_at")
  /// Vibe signal (PRODUCT_SPEC §1.3 / §3.2). Collected as two short free-text
  /// onboarding answers right before the Magic Prompt step, asked of EVERY user
  /// regardless of AI-memory export choice. The raw text feeds icebreakers and
  /// is folded into `psychologicalSummary` so the embedding (V_explicit) carries
  /// real psychological signal even when the Magic Prompt is declined.
  ///   - `fridayVibeText`: "describe your ideal Friday night, honestly".
  ///   - `vibeFocusText`: "what matters more — the process, or who's with you?".
  fridayVibeText            String?                      @map("friday_vibe_text")
  vibeFocusText             String?                      @map("vibe_focus_text")
  /// Structured axes extracted from the two vibe answers at finalize, scored by
  /// V_research (quadrant proximity). `[-1,+1]` continuous.
  ///   - `energyAxis`: internal (-1) ↔ external (+1) energy — the "tempo" axis.
  ///   - `orientationAxis`: experience (-1) ↔ connection (+1).
  energyAxis                Float?                       @map("energy_axis")
  orientationAxis           Float?                       @map("orientation_axis")
  /// Social role inferred from the vibe answers: initiator | participant |
  /// observer (whitelist-validated in app code, NOT a Prisma enum — mirrors
  /// `CuratedVenue.category`). STORED but not yet scored: role-complementarity
  /// matching (Phase 2) is deferred until there is accept/decline data to
  /// validate it against. See PRODUCT_SPEC §3.2.
  socialRole                String?                      @map("social_role")
  /// Concrete "anchor" interests pulled from the vibe answers (food, music,
  /// nature, ideas, humor, …). Icebreaker fuel + future shared-anchor scoring;
  /// the embedding stays authoritative for anchor similarity in v1.
  anchorTags                String[]                     @default([]) @map("anchor_tags")
  /// Idempotency/audit marker: when the vibe-axis extraction last ran. Guards
  /// the accepted-path summary append so finalize retries don't double-append.
  vibeExtractedAt           DateTime?                    @map("vibe_extracted_at")
  /// Type Radar (PRODUCT_SPEC §Type Radar / TYPE_RADAR_PRODUCT_SPEC.md). A fast
  /// visual appearance-preference calibration shown in onboarding right BEFORE
  /// the Magic Prompt: the user reacts "My Type" / "Not My Type" to ~12
  /// contrasting portraits (band chosen from the viewer's own age via
  /// `ageBandFor`), optionally tapping one reason chip. Pure math lives in
  /// `@gennety/shared` (`type-radar.ts`); feature-flagged by `TYPE_RADAR_ENABLED`
  /// and scored as the soft `V_type` multiplier (shadow-safe: `TYPE_PREF_FLOOR`
  /// default 1.0 = no effect). All columns are additive/nullable.
  ///   - `typeRadarAnswers`: raw verdict log `[{cardId, verdict, chipId?}]`.
  ///   - `typePrefTags`: compiled preference vector from `buildPreferenceVector`
  ///     (per attribute-value weight); the only thing matching reads.
  ///   - `typeRadarAgeBand`: `'a'|'b'|'c'` band the user actually rated.
  typeRadarAnswers          Json[]                       @default([]) @map("type_radar_answers")
  typePrefTags              Json?                        @map("type_pref_tags")
  typeRadarCompletedAt      DateTime?                    @map("type_radar_completed_at")
  typeRadarAgeBand          String?                      @map("type_radar_age_band")
  /// Relationship intent (PRODUCT_SPEC §1.3 / §3.2) — the one thing onboarding
  /// asks about the FUTURE, picked on the last of the Mini App's own profile
  /// screens. One ordered axis (`spark` | `open` | `falling` | `longterm`,
  /// see `@gennety/shared` `relationship-intent.ts`); whitelist-validated in
  /// app code, NOT a Prisma enum — mirrors `socialRole` / `CuratedVenue.category`,
  /// so a fifth point on the axis costs no migration.
  ///
  /// Read by the soft `V_intent` match multiplier and by nothing else. Two
  /// rules ride on that:
  ///   - it deliberately does NOT feed the embedding. Folded into
  ///     `psychologicalSummary` it would arrive through `V_explicit` at weight
  ///     0.65 — the single most influential term in the formula, i.e. the exact
  ///     opposite of "a nudge inside a league".
  ///   - it is never shown to the partner. The owner sees it in My Profile with
  ///     a "only you can see this" line; the pitch never carries it, so nobody
  ///     decides on a label before reading the person (founder decision).
  /// Null on every legacy row and on the iOS rail until it ships the screen —
  /// `intentMultiplier` returns exactly 1.0 for an absent value.
  relationshipIntent        String?                      @map("relationship_intent")
  /// Structured appearance tags for THIS user as a candidate (hairColor, build,
  /// beard, tattoos, …), scored against a partner's `typePrefTags` by `V_type`.
  /// Piggybacks the Elo cold-start vision pass (no extra OpenAI call). Null until
  /// that pass runs / for legacy rows; `V_type` is neutral (0.5→floor) when absent.
  appearanceTags            Json?                        @map("appearance_tags")
  createdAt                 DateTime                     @default(now()) @map("created_at")
  updatedAt                 DateTime                     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([profilerNextAt])
  @@map("profiles")
}

/// One row per (user, Profiler question). The Profiler (PRODUCT_SPEC §Phase 1b)
/// asks gender-specific questions in timed batches to fuel icebreakers and
/// date-planning hints. Deliberately NOT an input to the matching algorithm.
///
/// A question is answered at most once per user lifetime (`@@unique`); a later
/// drop cycle re-asks only still-unanswered questions. `skipped`/`skipReturned`
/// implement the "a skipped question comes back once per cycle, then drops"
/// rule; `cycleId` records the drop cycle the row was last touched in.
model ProfilerAnswer {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  /// Stable question identifier from the shared question bank (e.g. "f_date_spots").
  questionId   String           @map("question_id")
  priority     ProfilerPriority
  /// Free-text answer. Null while the question is only skipped (not answered).
  answerText   String?          @map("answer_text")
  answeredAt   DateTime?        @map("answered_at")
  /// True when the user tapped "Skip" instead of answering.
  skipped      Boolean          @default(false)
  /// True once a skipped question has been re-offered the one allowed time in
  /// its cycle, so it isn't surfaced a third time until the next drop cycle.
  skipReturned Boolean          @default(false) @map("skip_returned")
  /// Drop cycle this row was last asked/answered in (ISO date of the drop).
  cycleId      String           @map("cycle_id")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@map("profiler_answers")
}

/// One optional voice prompt per user (VOICE_PROMPT_PRODUCT_SPEC.md).
///
/// A short self-recorded clip the partner hears inside the pitch, right before
/// the accept/decline question. Deliberately NOT an entry in
/// `Profile.profileMedia`: a Telegram voice note cannot join a media group, so
/// it is a separate `sendVoice` regardless, and keeping it out leaves the
/// `photos[i] <-> photoFaceScores[i]` invariant and every media parser
/// untouched.
///
/// `@@unique` on `userId` is what enforces "0 or 1" in the database rather than
/// in application code; a re-record overwrites the row, so there is no history
/// and no reconciliation.
model VoicePrompt {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  /// Telegram `file_id` of the accepted voice note. On the Telegram rail this
  /// is the ONLY copy — Telegram is the store and we hold the pointer, exactly
  /// as profile photos and the profile video already work.
  telegramFileId String? @map("telegram_file_id")
  /// Supabase object path, written only when a native client uploaded bytes
  /// directly. Null on a Telegram-originated prompt. MUST be covered by
  /// `collectOwnedPaths` in services/account-deletion.ts — a miss there leaves
  /// audio in the bucket after an erasure request, silently.
  storagePath    String? @map("storage_path")

  durationSec Int     @map("duration_sec")
  mimeType    String? @map("mime_type")
  fileSize    Int?    @map("file_size")

  /// Normalized 0..100 amplitude peaks, VOICE_PROMPT_WAVEFORM_BUCKETS long.
  /// Telegram draws its own waveform and ignores this; it exists so the native
  /// player can render bars before fetching any audio, and so that shipping it
  /// later never needs a backfill over recordings whose source bytes are gone.
  waveform Int[] @default([]) @map("waveform")

  /// Whisper transcript. Two jobs, and the second is why this column is
  /// load-bearing rather than an audit nicety: it is moderation evidence, AND
  /// it is the matching signal — `refreshDirtyEmbeddings` reads it straight
  /// from here and appends it to the embedding input, the same way it already
  /// treats `partnerPreferences` and `negativeConstraints`. It is deliberately
  /// NOT folded into `psychologicalSummary`: that field is replaced wholesale
  /// by the About-me editor, and a transcript changes on every re-record, so
  /// folding would mean both a silent wipe and a weight that multiplies.
  ///
  /// Never rendered to the partner. The product ships a person's voice, not a
  /// machine's reading of it.
  transcript String? @map("transcript")

  /// Safety-validation bookkeeping, mirroring profile media.
  validationVersion Int?      @map("validation_version")
  validatedAt       DateTime? @map("validated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("voice_prompts")
}

/// The Dating Scratch Map: which parts of the city this person has actually
/// been in (PRODUCT_SPEC §Scratch Map). One row per user, created lazily on
/// their first recorded tile.
///
/// **Tiles, not coordinates, and that is the privacy design rather than a
/// storage choice.** `exploredTiles` holds geohash precision 6 — roughly
/// 1.2 km × 0.6 km — so the column can say "they have been around Podil" and
/// can never say which building. The product's existing geo columns are all
/// per-purpose and per-match (`Match.vibeLat*` is a departure pin for ONE
/// date); this is the first thing that accumulates, so it is the one place
/// where the shape of what is stored has to carry the guarantee.
///
/// Written only with `User.scratchMapOptIn` true, and only from a foreground
/// ping (the user has the map open) or a verified Date Bump. Nothing here is
/// written from the background: there is no background-location entitlement in
/// the iOS app and no such permission requested in the Mini App, which is what
/// makes that promise structural rather than a rule someone has to remember.
model UserScratchMap {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  /// Geohash-6 tiles the user has uncovered. A set, kept sorted and unique by
  /// the service — Postgres arrays do not enforce either, and a duplicate
  /// would silently inflate `exploredPercent`.
  exploredTiles String[] @default([]) @map("explored_tiles")

  /// Materialized `exploredTiles.length / <tiles in the market>`, in [0..1].
  /// Stored rather than derived because the client draws it on every frame of
  /// the canvas and the denominator is a per-market constant the database does
  /// not know.
  exploredPercent Float @default(0) @map("explored_percent")

  /// Venues this user has been verified at by a Date Bump, as Google **Place
  /// ids** (`Match.venuePlaceId`) — free-form, no FK, so deleting a venue from
  /// the catalog never erases someone's history of having been there. The same
  /// rule `TicketLedger.matchId` already follows.
  ///
  /// **NOT `CuratedVenue.id`, and that is a correction rather than a
  /// preference.** The catalog has no uniqueness constraint and the seeder
  /// writes one row per `universityDomain` — Kyiv holds ~538 rows for ~127 real
  /// venues — so every other reader in the product already dedupes by
  /// `placeId`. Storing one of five arbitrary uuids would give two people who
  /// sat in the same café different "discovered venues", which is the one thing
  /// this column exists to get right. A Places-fallback venue has a place id
  /// too, while it has no curated row at all.
  discoveredVenues String[] @default([]) @map("discovered_venues")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_scratch_maps")
}

enum MatchStatus {
  proposed
  negotiating
  negotiating_venue
  scheduled
  cancelled
  completed
  expired
}

enum MatchEventActionType {
  PROPOSAL_SHOWN
  ACCEPTED
  DECLINED
  DATE_COMPLETED
  CHEMISTRY_POSITIVE
  CHEMISTRY_NEGATIVE
  /// 24h TTL elapsed without the user replying — this row's `actorId` is
  /// the silent side. Emitted once per offending side per match.
  EXPIRED_SILENT
  /// Counterpart event for the side that DID respond on a match where the
  /// peer went silent past TTL. `actorId` is the responder, `targetId` the
  /// silent peer. Used for the "your match ignored you" notification audit.
  EXPIRED_PEER_IGNORED
}

model Match {
  id        String      @id @default(uuid()) @db.Uuid
  userAId   String      @map("user_a_id") @db.Uuid
  userBId   String      @map("user_b_id") @db.Uuid
  status    MatchStatus @default(proposed)
  pitchForA String?     @map("pitch_for_a")
  pitchForB String?     @map("pitch_for_b")

  /// AI Synergy Score — pair-level compatibility metric shown on the match
  /// reveal and upcoming-date screens. Always clamped server-side to the
  /// motivating 70..99 range; the LLM is *asked* for that range, but a
  /// clamp + fallback in `pitch-generator.ts` is the source of truth.
  /// `synergyReason`/`synergyReasonB` are a 1–2 sentence positive
  /// justification framed as "complementary" (70–79) or "highly aligned"
  /// (80–99). The score is pair-level (one number), but the reason is prose,
  /// so it is stored PER SIDE in that side's own language — mirroring
  /// `pitchForA`/`pitchForB`. `synergyReason` is side A's (kept under the
  /// original name so legacy rows and the founder report keep reading);
  /// `synergyReasonB` is side B's. A null `synergyReasonB` (legacy row)
  /// falls back to side A's text at render time.
  synergyScore   Int?    @map("synergy_score")
  synergyReason  String? @map("synergy_reason")
  synergyReasonB String? @map("synergy_reason_b")

  /// Per-user Accept/Decline state. NULL = pending, true = accepted,
  /// false = declined. Both must be true for the match to enter `negotiating`.
  acceptedByA Boolean? @map("accepted_by_a")
  acceptedByB Boolean? @map("accepted_by_b")

  /// Free-form reason captured from a user who declined the match. AI parses
  /// this text and appends distilled constraints to `Profile.negativeConstraints`.
  rejectionReasonA String? @map("rejection_reason_a")
  rejectionReasonB String? @map("rejection_reason_b")

  /// DEPRECATED. Pre-2026-05 the scheduler had three iterations (two rounds
  /// of bot inline-keyboard "single slot" picks, then a Mini App fallback).
  /// Current flow goes straight to the Mini App after both users accept;
  /// this column is kept for any in-flight rows mid-deploy and will be
  /// dropped in a follow-up cleanup migration.
  schedulingIteration Int        @default(0) @map("scheduling_iteration")
  /// Server-side allowlist of valid calendar slots (the visible grid in the
  /// Mini App). Generated when the match enters `negotiating`. The public
  /// `POST /v1/calendar/pick` endpoint validates every submitted slot
  /// against this list to prevent clients from POSTing arbitrary timestamps.
  proposedTimes       DateTime[] @map("proposed_times")
  /// Per-user availability set selected in the Mini App calendar. A non-empty
  /// intersection between `availableTimesA` and `availableTimesB` agrees the
  /// date — the *earliest* common slot wins so peer-confirmation taps land
  /// on the slot the partner actually marked.
  availableTimesA     DateTime[] @default([]) @map("available_times_a")
  availableTimesB     DateTime[] @default([]) @map("available_times_b")
  /// DEPRECATED. Single-slot picks from the legacy iter-1/2 inline keyboards.
  /// New flow uses `availableTimesA/B`; these stay for any in-flight matches
  /// at deploy time and will be dropped in a follow-up cleanup migration.
  pickedTimeA         DateTime?  @map("picked_time_a")
  pickedTimeB         DateTime?  @map("picked_time_b")

  agreedTime   DateTime? @map("agreed_time")
  venueName    String?   @map("venue_name")
  venueAddress String?   @map("venue_address")

  /// Phase 3.4: Concierge venue negotiation (after agreedTime is locked).
  /// Each user submits a free-text "vibe" (cafe/restaurant/park/etc.) and a
  /// Telegram Location pin of where they're commuting from. The bot computes
  /// the great-circle midpoint, safety-parses both vibes against a strict
  /// public-place whitelist, and queries Google Places centered on the
  /// midpoint. All fields nullable — populated incrementally as each user
  /// responds; once all four of (vibeText*, vibeLat*) pairs are present the
  /// match finalizes to `scheduled`.
  vibeTextA                 String?   @map("vibe_text_a")
  vibeTextB                 String?   @map("vibe_text_b")
  vibeLatA                  Float?    @map("vibe_lat_a")
  vibeLngA                  Float?    @map("vibe_lng_a")
  /// Human-readable address each user picked in the Location Mini App
  /// (e.g. "Lukyanivska Metro Station, Kyiv"). Used for display in the
  /// concierge confirmation message — not for the matching algorithm
  /// (lat/lng above is the source of truth for midpoint computation).
  /// Null when the user shared a raw location pin via Telegram's attach
  /// menu instead of using the Mini App.
  vibeAddressA              String?   @map("vibe_address_a")
  vibeAddressB              String?   @map("vibe_address_b")
  vibeLatB                  Float?    @map("vibe_lat_b")
  vibeLngB                  Float?    @map("vibe_lng_b")
  /// Whitelisted Places category after safety override (cafe | restaurant |
  /// coffee_shop | park | museum | lounge). Audit trail for overrides.
  parsedCategoryA           String?   @map("parsed_category_a")
  parsedCategoryB           String?   @map("parsed_category_b")
  /// Venue Intent V2 snapshots. A draft is replaced only when that user edits
  /// their text; finalisation consumes the confirmed JSON and never re-parses.
  venueIntentA              Json?     @map("venue_intent_a")
  venueIntentB              Json?     @map("venue_intent_b")
  /// V2 stores the route midpoint separately. For pre-V2 rows venueLat/Lng are
  /// the legacy midpoint and venueSelectionVersion remains null.
  venueMidpointLat          Float?    @map("venue_midpoint_lat")
  venueMidpointLng          Float?    @map("venue_midpoint_lng")
  /// Actual venue coordinates for V2 (legacy rows keep midpoint semantics).
  venueLat                  Float?    @map("venue_lat")
  venueLng                  Float?    @map("venue_lng")
  venuePlaceId              String?   @map("venue_place_id")
  venueSource               String?   @map("venue_source")
  venueSelectionVersion     String?   @map("venue_selection_version")
  venueSelectionConfidence  Float?    @map("venue_selection_confidence")
  venueSelectionReason      String?   @map("venue_selection_reason")
  venueSelectionAttempts    Int       @default(0) @map("venue_selection_attempts")
  venueSelectionNextRetryAt DateTime? @map("venue_selection_next_retry_at")
  venueSelectionError       String?   @map("venue_selection_error")
  /// Google Maps deep-link to the picked place (`googleMapsUri` from the
  /// Places API (New) response). Surfaced in the final scheduled DM so
  /// users can verify the venue exists and pre-check address / hours.
  /// Null on the legacy domain-based venue path (no Maps URI available
  /// there) and on local-stub fallbacks.
  venueGoogleMapsUri        String?   @map("venue_google_maps_uri")
  /// RETIRED 2026-07-25 — no longer read or written. Held an operator-owned
  /// curated photo URL, but no curated row ever had one, so curated picks (the
  /// primary source) always rendered a photo-less date card. Google Places is
  /// now the single venue-imagery source; see `venuePhotoName`. Column kept
  /// (all-null in production) so the change stays additive — drop it in a
  /// separate, deliberate migration.
  venuePhotoUrl             String?   @map("venue_photo_url")
  /// Date-card venue imagery (feature-flagged, `DATE_CARD_FEATURE_ENABLED`) —
  /// the SINGLE source. A Google Places photo *resource name*
  /// (`places/X/photos/Y`); the displayable media URL is rebuilt at card render
  /// time with the server-side key (`buildPlacesPhotoUrl`) so Google's raw bytes
  /// are never persisted (Places ToS). Places-sourced venues get it from the
  /// search response; curated venues have theirs resolved from their stored
  /// `placeId` at assignment (`fetchPlacePhotoName`). Null until `scheduled`.
  venuePhotoName            String?   @map("venue_photo_name")
  /// Telegram photo `file_id` of the rendered date-card PNG, captured per side
  /// the first time the `scheduled` confirmation card is sent
  /// (`DATE_CARD_FEATURE_ENABLED`). Lets the "My date" menu hub re-open the card
  /// instantly instead of re-rendering it (satori/resvg is a multi-second beat).
  /// Null until the card is actually sent (feature off, render/send failed, or
  /// the plain-text fallback was used). Cleared implicitly by never being read
  /// once the match leaves `scheduled`.
  dateCardFileIdA           String?   @map("date_card_file_id_a")
  dateCardFileIdB           String?   @map("date_card_file_id_b")
  /// Idempotency marker: when the concierge prompt was dispatched to both users.
  venuePromptAskedAt        DateTime? @map("venue_prompt_asked_at")

  /// Phase 4: Date lifecycle
  icebreakersSentAt    DateTime? @map("icebreakers_sent_at")
  /// Phase 4: Safety note sent to the female user 1.5h before `agreedTime`.
  /// Idempotency marker — null = not yet sent, timestamp = sent.
  safetyNoteSentAt     DateTime? @map("safety_note_sent_at")
  /// The participant who ended this match by hand. Named for the emergency
  /// cancellation of a `scheduled` date (§Phase 4), but also written by the
  /// planning-stage cancellation (§3.5c — "plans changed" at the scheduling or
  /// venue step), so the column means "who cancelled" rather than "who used the
  /// emergency button". Safe to share: both readers of it
  /// (`handlers/date/emergency.ts`, the agent's `propose_cancel_date`) are
  /// scoped to `status = 'scheduled'`, and a cancelled row has left that status.
  /// Null on a match that expired or was cancelled by the system.
  emergencyCancelledBy String?   @map("emergency_cancelled_by") @db.Uuid
  emergencyReason      String?   @map("emergency_reason")
  feedbackByA          String?   @map("feedback_by_a")
  feedbackByB          String?   @map("feedback_by_b")
  /// Did the date actually happen — answered by each side in their own words
  /// at T+24h (PRODUCT_SPEC §Phase 4 → "Did you actually meet?").
  ///
  /// Written ONLY by a human answer, never by the evidence classifier. That
  /// separation is the whole design: the classifier picks how the question is
  /// worded, so a wrong guess costs an odd sentence rather than a fabricated
  /// metric. Null = not answered, which is NOT the same as "didn't happen" and
  /// must never be rendered as `false`.
  ///
  /// Attendance is a property of the PAIR, so one credible `true` settles it
  /// for the match; the two columns exist because the sides can disagree, and
  /// a disagreement is a real state (`disputed`) that belongs on screen rather
  /// than silently collapsed. `Match.status = 'completed'` cannot answer this:
  /// it is stamped by the T+24h prompt whether or not anyone showed up.
  dateAttendedA        Boolean?  @map("date_attended_a")
  dateAttendedB        Boolean?  @map("date_attended_b")
  /// Why it didn't happen, on the "no" branch: `no_show_partner` /
  /// `no_show_self` / `both_rescheduled` / `other`. A plain string rather than
  /// a Prisma enum, like every other match sub-state here (`ticketStatus`,
  /// `coordMethod`, `venueChangeStatus`), so a new value costs no migration;
  /// the whitelist lives in `services/attendance.ts`.
  ///
  /// Deliberately separate from `feedbackBy*`: that blob is LLM-distilled into
  /// the answerer's `negativeConstraints`, and "she never turned up" is a fact
  /// about one evening, not a trait to penalise future candidates on.
  attendanceOutcomeA   String?   @map("attendance_outcome_a")
  attendanceOutcomeB   String?   @map("attendance_outcome_b")
  venueFitByA          String?   @map("venue_fit_by_a")
  venueFitByB          String?   @map("venue_fit_by_b")
  venueFitReasonsByA   String[]  @default([]) @map("venue_fit_reasons_by_a")
  venueFitReasonsByB   String[]  @default([]) @map("venue_fit_reasons_by_b")
  /// Idempotency marker for the post-date feedback DM. The prompt is sent
  /// once per match 24h after `agreedTime`; this column gates the cron tick
  /// so the same pair can't be re-prompted every 2 minutes when one or
  /// both users haven't replied yet. Pre-C-1 the cron used the status flip
  /// to `completed` + the null check on `feedbackBy{A,B}` as a dedup, which
  /// re-fired forever for unanswered prompts.
  feedbackPromptedAt   DateTime? @map("feedback_prompted_at")

  /// Timestamp when the AI pitch was dispatched to both users via the queue.
  /// Used by the 24h TTL cron to expire unanswered proposals.
  dispatchedAt DateTime? @map("dispatched_at")

  /// Telegram `message_id` of the dispatched pitch DM, captured per side.
  /// Used by the proposal-countdown worker to live-edit the "⏳ Xч left"
  /// plate, and by the expiry tick to overwrite the pitch with a final
  /// "срок истёк" notice. NULL when the user has no Telegram presence
  /// (mobile-first account, `telegramId <= 0`) or when send failed.
  pitchMessageIdA Int? @map("pitch_message_id_a")
  pitchMessageIdB Int? @map("pitch_message_id_b")

  /// Telegram `message_id` of the current Calendar Mini App card per side.
  /// Scheduling status updates replace this card instead of stacking another
  /// "Open Calendar" message in the chat. Cleared when a time is locked.
  calendarMessageIdA Int? @map("calendar_message_id_a")
  calendarMessageIdB Int? @map("calendar_message_id_b")

  /// Telegram `message_id` of the peer-wait FALLBACK line per side — the plain
  /// message shown to clients that cannot render a `<tg-thinking>` rich draft
  /// (PRODUCT_SPEC §3.6b). The rich path needs no column at all: a draft is
  /// ephemeral and simply stops being re-issued. The fallback message is a real
  /// message that must be edited on each rotation and DELETED when the wait
  /// ends, so its id has to survive a process restart — an in-memory map would
  /// strand a permanent "waiting for them…" line in the chat after any deploy.
  peerWaitMessageIdA Int?      @map("peer_wait_message_id_a")
  peerWaitMessageIdB Int?      @map("peer_wait_message_id_b")
  /// When the fallback line's text was last rewritten. The shimmer re-issues on
  /// every ~20s tick, but an edit is a real API call on a real message, so the
  /// fallback text is rewritten at most once a minute.
  peerWaitEditedAtA  DateTime? @map("peer_wait_edited_at_a")
  peerWaitEditedAtB  DateTime? @map("peer_wait_edited_at_b")
  /// When THIS side started waiting on its partner — the anchor the shimmer's
  /// five-tier wording ladder is measured from (PRODUCT_SPEC §3.6b). Nothing
  /// else answers "how long has this side been waiting": `acceptedByA/B` are
  /// booleans, `availableTimesA/B` carry no submission time, and the row's
  /// `updatedAt` moves for unrelated reasons.
  ///
  /// Written ONLY by `workers/peer-wait-shimmer.ts`, stamped on the first tick
  /// the side is seen waiting and cleared alongside `peerWaitMessageId*` when
  /// the wait ends. A single writer is deliberate — the action handlers that
  /// kick off the shimmer render tier 1 unconditionally (they only ever fire
  /// the instant the user commits), so they need no anchor of their own and
  /// cannot race the worker for it.
  peerWaitStartedAtA DateTime? @map("peer_wait_started_at_a")
  peerWaitStartedAtB DateTime? @map("peer_wait_started_at_b")

  /// Legacy nudge columns from the pre-C-6 era when proposal-phase and
  /// scheduling-phase nudges shared the same two slots. Kept nullable so old
  /// rows still parse — new code reads/writes the four phase-specific columns
  /// below. Safe to drop after a few release cycles.
  nudge1SentAt                DateTime? @map("nudge1_sent_at")
  nudge2SentAt                DateTime? @map("nudge2_sent_at")
  /// Proposal-phase nudges (status = "proposed", awaiting accept/decline).
  /// First reminder ≥3h after dispatchedAt, second ≥10h after.
  proposalNudge1SentAt        DateTime? @map("proposal_nudge1_sent_at")
  proposalNudge2SentAt        DateTime? @map("proposal_nudge2_sent_at")
  /// Scheduling-phase nudges (status = "negotiating", both accepted but no
  /// agreed slot yet). First reminder ≥6h since last update, second ≥12h.
  /// Split from the proposal nudges in C-6 so a row that already received a
  /// proposal nudge doesn't dead-letter the scheduling phase's nudge cadence.
  schedNudge1SentAt           DateTime? @map("sched_nudge1_sent_at")
  schedNudge2SentAt           DateTime? @map("sched_nudge2_sent_at")
  /// Deadline-anchored proposal reminder: one nudge fired ~2h BEFORE the 24h
  /// TTL expires (not anchored to dispatch like the two above), sent only to
  /// sides that still haven't decided. Idempotency marker for that single DM.
  proposalDeadlineNudgeSentAt DateTime? @map("proposal_deadline_nudge_sent_at")
  /// Venue-phase nudges (status = "negotiating_venue", a side hasn't submitted
  /// its departure point + vibe yet). Same 6h/12h cadence as the scheduling
  /// pair above, anchored on `venuePromptAskedAt`.
  venueNudge1SentAt           DateTime? @map("venue_nudge1_sent_at")
  venueNudge2SentAt           DateTime? @map("venue_nudge2_sent_at")

  /// When the Calendar was actually opened for this pair (`startScheduling`).
  /// The scheduling-phase cadence anchors here, NOT on `dispatchedAt`: a pair
  /// that accepted at hour 23 of the 24h decision window was already "6h past
  /// dispatch", so the first "pick a time" nudge could land minutes after the
  /// Calendar itself. It is also the stall anchor for the same phase. Null on
  /// rows created before this column existed — those fall back to
  /// `dispatchedAt`, preserving the old behaviour rather than never nudging.
  schedulingOpenedAt DateTime? @map("scheduling_opened_at")

  /// Stall check-in (PRODUCT_SPEC §3.5c) — the "still in?" question sent to a
  /// side that has owed an action for ~24h at the scheduling or venue phase.
  /// PER SIDE, unlike every nudge column above, because both participants can
  /// independently go quiet and each needs their own question and their own
  /// answer. `stallConfirmedAt*` records a 🟢 "still in" tap: it pushes that
  /// side's timeout deadline out and re-arms the check-in exactly once (the
  /// re-arm is gated on this column having been null, so the chain is bounded
  /// at two questions and can't be held open forever by tapping green).
  stallCheckInSentAtA DateTime? @map("stall_check_in_sent_at_a")
  stallCheckInSentAtB DateTime? @map("stall_check_in_sent_at_b")
  stallConfirmedAtA   DateTime? @map("stall_confirmed_at_a")
  stallConfirmedAtB   DateTime? @map("stall_confirmed_at_b")

  /// Phase 4 mobile: personalised ice-breakers persisted per side so the
  /// Expo app can display the same topics that Telegram users receive via DM.
  /// Populated by `runDateLifecycleTick` in the same step that marks
  /// `icebreakersSentAt`.
  iceBreakersA String[] @default([]) @map("ice_breakers_a")
  iceBreakersB String[] @default([]) @map("ice_breakers_b")

  /// Phase 4 mobile: per-side acknowledgement of the pre-date safety brief.
  /// Flipped by POST /v1/matches/:id/safety-ack. Independent from
  /// `safetyNoteSentAt` which only tracks the Telegram DM dispatch.
  safetyAckA Boolean @default(false) @map("safety_ack_a")
  safetyAckB Boolean @default(false) @map("safety_ack_b")

  /// Phase 4 "Wingman": single asymmetric insider tip per side. Generated
  /// when the match flips to `scheduled` (venue locked) and revealed to
  /// each side only within T-1.5h of `agreedTime` via the serializer gate.
  /// `wingmanSentAt` is the T-1.5h push idempotency marker.
  wingmanHintA  String?   @map("wingman_hint_a")
  wingmanHintB  String?   @map("wingman_hint_b")
  wingmanSentAt DateTime? @map("wingman_sent_at")

  /// Date Ticket monetization gate. Sits between mutual accept and the
  /// Calendar Mini App when `TICKET_FEATURE_ENABLED=true`; entirely inert
  /// when the flag is off (no offer is ever sent, columns keep defaults).
  /// Payment is MOCKED in v1 — see `services/ticket-payment.ts`; the
  /// `mock`/`stripe` switch is the single production toggle.
  ///
  /// `ticketStatus` lifecycle (string, validated in app code — not a Prisma
  /// enum, so adding states later needs no migration):
  ///   pending   — offer sent, neither side paid
  ///   partial   — exactly one side paid; `ticketExpiresAt` is the second
  ///               side's deadline
  ///   completed — both sides paid; scheduling unlocked
  ///   refunded  — `partial` lapsed; the paying side was refunded (mock) and
  ///               scheduling was opened for free (an accepted match is never
  ///               killed by a payment stall)
  ///   expired   — offer lapsed with nobody paid; scheduling opened for free
  ticketPriceCents    Int       @default(699) @map("ticket_price_cents")
  ticketPaidA         DateTime? @map("ticket_paid_a")
  ticketPaidB         DateTime? @map("ticket_paid_b")
  /// Set when a male user pays the $13.98 "for both of us" option — records
  /// which side settled the partner's ticket so the partner's Mini App shows
  /// the "[Name] already paid your ticket ❤️" screen.
  paidForPartnerByA   Boolean   @default(false) @map("paid_for_partner_by_a")
  paidForPartnerByB   Boolean   @default(false) @map("paid_for_partner_by_b")
  /// Read-receipt for the goodwill "he covered her ticket" gesture (§3.5b).
  /// `partnerPaidSeenAt` is stamped the first time the covered partner actually
  /// learns of it — either by opening the ticket-card reveal or by receiving the
  /// completion nudge — and gates the one-time "she saw it ❤️" DM back to the
  /// payer so it fires once. `partnerPaidNudgedAt` marks that the fallback nudge
  /// DM was sent to the covered partner (she never opened the card before the
  /// gate completed), so the nudge can't double-fire.
  partnerPaidSeenAt   DateTime? @map("partner_paid_seen_at")
  partnerPaidNudgedAt DateTime? @map("partner_paid_nudged_at")
  ticketStatus        String    @default("pending") @map("ticket_status")
  /// Deadline for the second side to pay once the first has (the `partial`
  /// window). Drives the Mini App countdown and the hourly ticket-expiry
  /// cron's refund sweep. Null outside the `partial` state.
  ticketExpiresAt     DateTime? @map("ticket_expires_at")

  /// --- Pre-date coordination (feature-flagged, PRODUCT_SPEC §Phase 4) ---
  /// String sub-state machine layered on top of a `scheduled` match — like
  /// `ticketStatus`, deliberately not a Prisma enum so the scheduling/venue
  /// lifecycle code is untouched. Inert when `COORDINATION_FEATURE_ENABLED`
  /// is off. The female participant (or, in same-sex pairs, whoever taps
  /// first) is offered three ways to find each other at the spot at T-60m.
  coordOfferSentAt    DateTime? @map("coord_offer_sent_at")
  /// User who actually picked a method (the offer's first tapper).
  coordInitiatorId    String?   @map("coord_initiator_id") @db.Uuid
  /// share_self (A) | request_partner (B) | proxy (C). Null = not chosen yet.
  coordMethod         String?   @map("coord_method")
  coordChosenAt       DateTime? @map("coord_chosen_at")
  /// Variant B ONLY: null = awaiting partner, true = approved (contact
  /// revealed), false = declined. Variant C opens unconditionally (no consent)
  /// so an offline partner can never strand the initiator at T-30m.
  coordPartnerConsent Boolean?  @map("coord_partner_consent")
  /// Terminal stamp: contact revealed (A/B) or proxy method locked in (C).
  coordResolvedAt     DateTime? @map("coord_resolved_at")
  /// Variant C anonymous proxy window. Opened at T-30m by the coordination
  /// cron, closed at agreed_time + PROXY_CLOSE_AFTER_HOURS.
  proxyOpenedAt       DateTime? @map("proxy_opened_at")
  proxyClosesAt       DateTime? @map("proxy_closes_at")
  proxyClosedAt       DateTime? @map("proxy_closed_at")

  /// --- Venue change v2 (feature-flagged, paid multiplayer board) ---
  /// String sub-state layered on a `scheduled` match — like `ticketStatus`
  /// and `coordMethod`, deliberately NOT a MatchStatus enum value so the
  /// scheduling/venue/lifecycle code that switches on `status` is untouched.
  /// Inert when VENUE_CHANGE_FEATURE_ENABLED is off. v2 lifecycle
  /// (PRODUCT_SPEC §3.7b — the v1 propose/veto values are retired; the
  /// feature never launched, so no in-flight v1 rows exist):
  ///   null      — no session (nobody liked anything yet)
  ///   "liking"  — board session open; likes exist, no agreement yet
  ///   "agreed"  — a venue is agreed (board overlap or express mint),
  ///               awaiting the VENUE_CHANGE_STARS payment; the venueChange*
  ///               fields below hold the agreed venue
  ///   "settled" — paid; venueChange* copied onto the canonical venue* fields
  ///   "lapsed"  — payment deadline passed unpaid → original venue stands
  ///               (the match is NEVER cancelled by a venue change)
  /// `settled` and `lapsed` are terminal for the SESSION, not for the date:
  /// either can be restarted into a fresh `liking` round while
  /// `venueChangeCount` is under its cap (PRODUCT_SPEC §3.7b). The restart
  /// wipes every venueChange* field below in the same CAS that writes the new
  /// round's first like — these columns are one slot, not a history.
  venueChangeStatus         String?   @map("venue_change_status")
  /// v2: the session INITIATOR — whoever placed the session's first like (or
  /// minted the express invoice). Drives the payer matrix: hetero → the male
  /// pays regardless; same-sex → the initiator pays.
  venueChangeProposerId     String?   @map("venue_change_proposer_id") @db.Uuid
  /// v2: session-open stamp (first like / express mint). CAS guard for the
  /// initiator claim.
  venueChangeProposedAt     DateTime? @map("venue_change_proposed_at")
  /// Payment deadline for an `agreed` venue = min(agreedAt +
  /// VENUE_CHANGE_TTL_HOURS, agreedTime - DATE_ALERT_HOURS). Drives the
  /// lifecycle lapse sweep.
  venueChangeExpiresAt      DateTime? @map("venue_change_expires_at")
  venueChangeResolvedAt     DateTime? @map("venue_change_resolved_at")
  /// Agreed replacement venue (server-resolved catalog snapshot — never the
  /// client's own strings).
  venueChangeName           String?   @map("venue_change_name")
  venueChangeAddress        String?   @map("venue_change_address")
  venueChangeLat            Float?    @map("venue_change_lat")
  venueChangeLng            Float?    @map("venue_change_lng")
  venueChangeMapsUri        String?   @map("venue_change_maps_uri")
  venueChangePlaceId        String?   @map("venue_change_place_id")
  /// Legacy v1 column (the mandatory-comment relay) — retained, never written
  /// by v2 (the board has no free text at all).
  venueChangeComment        String?   @map("venue_change_comment")
  /// v2 board likes, one Json[] per side. Each entry is a server-resolved
  /// venue snapshot: { key, placeId, name, address, lat, lng, mapsUri,
  /// category, tier, photoRef }. `key` = placeId ?? "name|address".
  /// (A legacy `photoUrl` member may exist on rows written before 2026-07-25;
  /// it is ignored on read.)
  venueLikesA               Json[]    @map("venue_likes_a")
  venueLikesB               Json[]    @map("venue_likes_b")
  /// RETIRED 2026-07-25 alongside `venuePhotoUrl` — no longer read or written.
  venueChangePhotoUrl       String?   @map("venue_change_photo_url")
  /// Agreed-venue Google Places photo resource name, copied onto
  /// `venuePhotoName` at settle so the updated date card renders the NEW
  /// venue's photo. Resolved from the agreed venue's `placeId` at agreement /
  /// express mint, since curated board rows carry no imagery of their own.
  venueChangePhotoName      String?   @map("venue_change_photo_name")
  /// Who actually paid the Stars and when (settle stamp).
  venueChangePaidById       String?   @map("venue_change_paid_by_id") @db.Uuid
  venueChangePaidAt         DateTime? @map("venue_change_paid_at")
  /// The male's single, final "not this time" on paying (his finalizer fork
  /// or the wish card). Non-null permanently hides her "offer him to pay"
  /// option for this session.
  venueChangePayDeclinedAt  DateTime? @map("venue_change_pay_declined_at")
  /// Wish-card guard: set once when she offers him to pay (no duplicate cards).
  venueChangeOfferPaySentAt DateTime? @map("venue_change_offer_pay_sent_at")
  /// Board-invite DM per recipient side: when it was last (re)sent, and the id
  /// of the message currently living in their chat. There is only ever ONE such
  /// message per side — a fresh submission deletes the previous one and posts a
  /// new one, so the invite is always the latest message rather than a pile of
  /// near-identical pings while the pair is still making up their minds.
  venueChangePingSentToAAt  DateTime? @map("venue_change_ping_sent_to_a_at")
  venueChangePingSentToBAt  DateTime? @map("venue_change_ping_sent_to_b_at")
  venueChangePingMsgIdA     Int?      @map("venue_change_ping_msg_id_a")
  venueChangePingMsgIdB     Int?      @map("venue_change_ping_msg_id_b")
  /// Non-null marks the current `agreed` state as an EXPRESS mint (her
  /// unilateral silent swap): hidden from the partner until settled, and a
  /// lapse stays silent for the partner (they never knew).
  venueChangeExpressAt      DateTime? @map("venue_change_express_at")
  /// Tier of the agreed venue-change venue (`base` | `premium`), stamped at
  /// agreement. Drives the Gennety Premium fee waiver: a `premium` venue (or a
  /// `base` venue settled by a premium user) is free; a `base` venue settled by
  /// a non-premium user costs VENUE_CHANGE_STARS + shows the counterfactual
  /// upsell. Null = no agreed venue / legacy row. See PRODUCT_SPEC.md §Premium.
  venueChangeTier           String?   @map("venue_change_tier")
  /// How many venue changes have actually SETTLED on this date, capped by
  /// VENUE_CHANGE_MAX_PER_DATE (PRODUCT_SPEC §3.7b). Incremented by both settle
  /// paths — the paid one and the Premium free one — which is exactly why the
  /// cap cannot be derived from `venue_change_purchases`: a free settle writes
  /// no purchase row, so a subscribing pair (and every demo visitor, where the
  /// change is free by design) would be uncapped. A lapse costs nothing and
  /// does not increment. Defaulted so historical rows read 0.
  venueChangeCount          Int       @default(0) @map("venue_change_count")

  /// How this pair was allocated: `weekly` (the Thursday batch — the default and
  /// the only value before Rematch) or `rematch` (a paid, on-demand single-seeker
  /// run bought by one man, REMATCH_PRODUCT_SPEC.md). String, not a Prisma enum,
  /// matching `ticketStatus`/`venueChangeStatus`/`coordMethod`; whitelist lives
  /// in app code. Analytics that measure the weekly optimizer's quality filter to
  /// `weekly` so on-demand runs don't pollute the score A/B.
  source          String  @default("weekly")
  /// The buyer of a `rematch`-sourced pair (always the male participant). Null
  /// for weekly pairs. The reverse link (match ← purchase) lives on
  /// `RematchPurchase.resultMatchId`; this side exists so support/founder
  /// surfaces can see "who paid for this" without a second query.
  rematchPaidById String? @map("rematch_paid_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userA User @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)

  events             MatchEvent[]
  reports            Report[]
  blocks             UserBlock[]
  scoreLog           MatchScoreLog?
  proxyMessages      ProxyMessage[]
  venueSelectionLogs VenueSelectionLog[]
  bumpSession        DateBumpSession?

  @@index([status, createdAt])
  @@index([userAId, userBId])
  /// Drives the ticket-expiry cron's sweep for `partial`/`pending` rows
  /// whose `ticketExpiresAt` has lapsed.
  @@index([ticketStatus, ticketExpiresAt])
  /// Drives the coordination cron's T-60m offer sweep.
  @@index([status, coordOfferSentAt])
  /// Drives the coordination cron's proxy open/close sweeps.
  @@index([coordMethod, proxyClosedAt])
  /// Drives the venue-change TTL/cutoff expiry sweep on the lifecycle tick.
  @@index([venueChangeStatus, venueChangeExpiresAt])
  @@map("matches")
}

/// Structured, append-only audit trail for live and shadow venue ranking.
/// Raw preference text is deliberately excluded.
model VenueSelectionLog {
  id              String   @id @default(uuid()) @db.Uuid
  matchId         String   @map("match_id") @db.Uuid
  mode            String
  parserVersion   String   @map("parser_version")
  rankerVersion   String   @map("ranker_version")
  intentA         Json     @map("intent_a")
  intentB         Json     @map("intent_b")
  /// `{ candidates: [{placeId, score}], poolSizes: {afterGeo, afterHardFilters, ranked} }`.
  /// `poolSizes` is the selection funnel — how many venues survived each stage.
  /// Without it, a pool collapse is invisible: the `.slice(0, 20)` that left 20
  /// of 661 eligible Kyiv venues in the running was only ever found by a manual
  /// query against the live database.
  topCandidates   Json     @map("top_candidates")
  selectedSource  String?  @map("selected_source")
  selectedPlaceId String?  @map("selected_place_id")
  failureReason   String?  @map("failure_reason")
  /// The pair's matching city, frozen at selection time so concentration
  /// analytics group without joining `matches → users → profiles` on every
  /// dashboard request — the same reason `match_score_logs` freezes its
  /// breakdown. Nullable: rows written before this column, and pairs whose
  /// profiles carry no `homeCityKey`.
  cityKey         String?  @map("city_key")
  latencyMs       Int      @map("latency_ms")
  placesCallCount Int      @map("places_call_count")
  chipCorrections Int      @default(0) @map("chip_corrections")
  createdAt       DateTime @default(now()) @map("created_at")

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
  @@index([mode, createdAt])
  @@index([cityKey, createdAt])
  @@map("venue_selection_logs")
}

/// Append-only audit log of every message relayed through a Variant C
/// anonymous proxy chat. Backs the moderation trail that justifies the
/// time-boxed carve-out to the "NO IN-APP CHAT" product invariant — relayed
/// content is fully logged and reportable. Cascades on Match deletion (GDPR).
model ProxyMessage {
  id        String   @id @default(uuid()) @db.Uuid
  matchId   String   @map("match_id") @db.Uuid
  senderId  String   @map("sender_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
  @@map("proxy_messages")
}

/// Score breakdown frozen at match-creation time. One row per Match.
/// Powers `/admin/analytics/algorithm`: lets us correlate each component
/// (V_explicit, V_research, V_league, V_penalty) against the eventual
/// accept/decline outcome — needed for A/B testing scoring weights.
/// Decoupled from `Match` so the heavy analytics scans don't touch the
/// hot match table.
model MatchScoreLog {
  id                String   @id @default(uuid()) @db.Uuid
  matchId           String   @unique @map("match_id") @db.Uuid
  /// Embedding cosine similarity in [0..1] (1 = identical).
  scoreExplicit     Float    @map("score_explicit")
  /// Sociological heuristic score in [0..1].
  scoreResearch     Float    @map("score_research")
  /// Elo-distance multiplier in [0..1] (1 = same league).
  scoreLeague       Float    @map("score_league")
  /// Negative-constraint penalty in [0..1] (higher = worse).
  scorePenalty      Float    @map("score_penalty")
  /// Stated age-range preference multiplier in [floor..1] (1 = candidate in the
  /// seeker's preferred partner age band, or no band set). Multiplies the
  /// positive bracket alongside `scoreLeague`. Defaults to 1 so historical rows
  /// logged before this factor existed read as neutral.
  scoreAgePref      Float    @default(1) @map("score_age_pref")
  /// Type Radar appearance-preference multiplier in [floor..1] (1 = candidate's
  /// `appearanceTags` match the seeker's `typePrefTags`, or no radar signal).
  /// Multiplies the positive bracket alongside `scoreLeague`/`scoreAgePref`.
  /// Defaults to 1 so rows logged before the factor existed — and every row
  /// while `TYPE_RADAR_ENABLED`/`TYPE_PREF_FLOOR` keep it inert — read as neutral.
  scoreType         Float    @default(1) @map("score_type")
  /// Relationship-intent agreement multiplier in [floor..1] (1 = same intent,
  /// or either side has none on file). The weakest factor in the formula by
  /// design — see `@gennety/shared` `relationship-intent.ts`. Defaults to 1 so
  /// rows logged before it existed, and every row while `INTENT_FLOOR` is 1.0,
  /// read as neutral.
  scoreIntent       Float    @default(1) @map("score_intent")
  /// Final composite (after weights + starvation bonus).
  scoreTotal        Float    @map("score_total")
  /// Pairwise embedding L2 distance, kept for debugging / re-ranking.
  embeddingDistance Float?   @map("embedding_distance")
  /// Capped priority bonus from the starvation tier (max of two sides).
  starvationBonus   Float    @default(0) @map("starvation_bonus")
  createdAt         DateTime @default(now()) @map("created_at")

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([scoreTotal])
  @@map("match_score_logs")
}

/// One Date Bump per match — the pair confirming, with a physical act, that they
/// are sitting at the same table (PRODUCT_SPEC §Date Bump). Both people shake
/// their phones; the pair is verified when the two shakes land within
/// `BUMP_WINDOW_MS` of each other AND both coordinates are inside
/// `BUMP_RADIUS_M` of the venue.
///
/// **This is the only thing in the product that observes attendance rather than
/// asking about it**, which is why it is allowed to write `Match.dateAttended*`
/// while the T+24h evidence classifier is forbidden from doing so
/// (`services/attendance.ts`). The rule that separation protects is "only a
/// human answer becomes data" — and a Bump IS a human answer: two people,
/// deliberately, at the venue, at the time. A classifier guessing from a proxy
/// chat is not.
///
/// A row exists from the first shake, so `userAShakeAt`/`userBShakeAt` also
/// carry the half-open state: one side waiting for the other. `isVerified` is
/// the claim, and `verifiedAt` is when it was granted — kept separate because
/// the rewards (reliability, the bonus ticket, the deck) are transactional with
/// the flag flip and must never re-run on a repeated shake.
model DateBumpSession {
  id      String @id @default(uuid()) @db.Uuid
  matchId String @unique @map("match_id") @db.Uuid

  /// When each side shook. NULL = that side has not bumped yet. Which side is
  /// A and which is B follows `Match.userAId`/`userBId`, never arrival order —
  /// otherwise a retry by the same person would look like the pair.
  userAShakeAt DateTime? @map("user_a_shake_at")
  userBShakeAt DateTime? @map("user_b_shake_at")

  isVerified Boolean   @default(false) @map("is_verified")
  verifiedAt DateTime? @map("verified_at")

  /// The at-the-table AI icebreaker deck, generated once at verification:
  /// `{ topicsForA: string[], topicsForB: string[] }`, each in that side's own
  /// language (same per-side rule as `Match.pitchForA`/`pitchForB`).
  ///
  /// Deliberately NOT the same thing as `Match.iceBreakersA/B`, which the
  /// lifecycle sends five hours BEFORE the date to a person who is still
  /// deciding what to wear. This deck is unlocked by the pair actually meeting
  /// and is written for a conversation already in progress; the earlier one is
  /// untouched.
  icebreakerDeck Json? @map("icebreaker_deck")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@map("date_bump_sessions")
}

model MatchEvent {
  id         String               @id @default(uuid()) @db.Uuid
  matchId    String               @map("match_id") @db.Uuid
  actorId    String               @map("actor_id") @db.Uuid
  targetId   String               @map("target_id") @db.Uuid
  actionType MatchEventActionType @map("action_type")
  metadata   Json?
  createdAt  DateTime             @default(now()) @map("created_at")

  match  Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  actor  User  @relation("MatchEventActor", fields: [actorId], references: [id], onDelete: Cascade)
  target User  @relation("MatchEventTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
  @@index([actorId, createdAt])
  @@index([targetId, createdAt])
  @@index([actionType, createdAt])
  @@map("match_events")
}

/// Post-match report filed by one participant against the other.
/// LLM-triaged into Tier 1 (preference), Tier 2 (ethical), or Tier 3 (safety).
/// Tier 3 rows stay `adminReviewed=false` until a human clears them.
model Report {
  id            String   @id @default(uuid()) @db.Uuid
  reporterId    String   @map("reporter_id") @db.Uuid
  reportedId    String   @map("reported_id") @db.Uuid
  matchId       String   @map("match_id") @db.Uuid
  rawText       String   @map("raw_text")
  tier          Int
  reasonSummary String?  @map("reason_summary")
  adminReviewed Boolean  @default(false) @map("admin_reviewed")
  createdAt     DateTime @default(now()) @map("created_at")

  reporter User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User  @relation("ReportReported", fields: [reportedId], references: [id], onDelete: Cascade)
  match    Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([reporterId, matchId])
  @@index([reportedId, tier, createdAt])
  @@index([tier, adminReviewed, createdAt])
  @@map("reports")
}

/// One user blocking another (App Store guideline 1.2: a product carrying
/// user-generated content must offer BOTH a report and a block). Sibling of
/// `Report` and deliberately separate from it: a report is an accusation
/// addressed to moderation, a block is a boundary that needs no accusation and
/// no review.
///
/// **Directional in storage, symmetric in effect.** The row records who blocked
/// whom, because that is what the blocker's own list must show and un-do. Every
/// consumer — the candidate SQL, the drop batch — reads it in both directions,
/// so neither side is ever offered the other again.
///
/// **The blocked side is never told.** They receive the ordinary cancellation
/// notice a freeze produces, which is why blocking is safe to offer to someone
/// who is frightened of the person they are blocking.
///
/// `matchId` is the surface the block was filed from, kept for moderation
/// context only. Nullable with `SetNull`, because a block must outlive the
/// match that produced it — the boundary is between two people, not two rows.
model UserBlock {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  matchId   String?  @map("match_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  blocker User   @relation("UserBlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User   @relation("UserBlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  match   Match? @relation(fields: [matchId], references: [id], onDelete: SetNull)

  /// Makes re-blocking idempotent instead of a second row.
  @@unique([blockerId, blockedId])
  /// The reverse direction is read on every candidate query, so it is indexed
  /// too — `blockerId` alone is already covered by the unique above.
  @@index([blockedId])
  @@map("user_blocks")
}

/// Append-only upload-time validation rejection log. Contains only coarse
/// reason codes and media type, never raw media, provider payloads, face crops,
/// hashes, embeddings, or user-facing file identifiers.
model MediaValidationRejection {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  mediaType       String   @map("media_type")
  rejectionReason String   @map("rejection_reason")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([mediaType, rejectionReason, createdAt])
  @@map("media_validation_rejections")
}

model BotSession {
  key       String   @id
  data      Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("bot_sessions")
}

/// Email-OTP challenges for the public mobile API (`POST /v1/auth/otp/*`).
/// Keyed by email (not userId) — user rows may not exist yet at request time.
/// `code` is stored as a bcrypt hash; raw code is only delivered via email.
model EmailOtp {
  id         String    @id @default(uuid()) @db.Uuid
  email      String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@map("email_otps")
}

/// APNs push tokens for the native app's Live Activities (ActivityKit).
/// One row per (user, activity type, token kind): `activityType` ∈
/// "match_decision" | "date_day", `kind` ∈ "start" (push-to-start) |
/// "update" (per-activity update token). The single-live-match invariant
/// means a user never runs two activities of one type, so the composite
/// unique is enough — re-registration upserts in place, and a dead token
/// (APNs `Unregistered`) deletes the row. Written by
/// `public/routes/live-activity.ts`; consumed by
/// `services/push.ts → sendLiveActivityUpdateToUser`.
model LiveActivityToken {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityType String   @map("activity_type")
  kind         String
  matchId      String?  @map("match_id") @db.Uuid
  token        String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([userId, activityType, kind])
  @@map("live_activity_tokens")
}

/// Native-app phone-code challenges (general track on iOS/Android, where the
/// Telegram one-tap `message.contact` rail does not exist). Twin of
/// `email_otps`, keyed by E.164 phone because the funnel starts before a User
/// row exists. `provider` records the delivery rail: "telegram_gateway"
/// stores our own bcrypt code hash (we generate the code and verify locally);
/// "twilio_verify" delegates code generation/checking to Twilio Verify
/// (`codeHash` null, `providerRequestId` = the Verification SID).
model PhoneOtp {
  id                String    @id @default(uuid()) @db.Uuid
  phone             String
  provider          String
  codeHash          String?   @map("code_hash")
  providerRequestId String?   @map("provider_request_id")
  expiresAt         DateTime  @map("expires_at")
  attempts          Int       @default(0)
  consumedAt        DateTime? @map("consumed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([phone, createdAt])
  @@map("phone_otps")
}

/// Active mobile refresh tokens. Access JWTs are stateless; refresh tokens are
/// persisted here (hashed) so revocation / rotation is server-controlled.
model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("user_sessions")
}

model SystemKnowledge {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  title     String
  content   String   @db.Text
  category  String   @default("general")
  priority  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_knowledge")
}

enum MessageRole {
  user
  assistant
  system
}

/// Mobile chat agent multimodal history. Distinct from `User.messageHistory`
/// (Json[] blob used by the legacy onboarding/menu agents) — this row-per-message
/// table powers the mobile-side chat UI with image attachments.
///
/// `imageUrl` stores the *opaque* Supabase Storage path (e.g.
/// `{userId}/{ts}.jpg`), never a public URL. Renderers mint short-lived signed
/// URLs at read time via `createChatImageSignedUrl`.
model Message {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  role      MessageRole
  content   String      @db.Text
  imageUrl  String?     @map("image_url")
  createdAt DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("messages")
}

/// Audit row for the empathetic "no match this week" DM that fires ~15 min
/// after the Thursday batch for every `active` user the matcher couldn't pair.
/// `tier` is the consecutive-famine count (1 = first week without a match,
/// 2 = second, 3+ = third or more) — drives the escalating warmth of the
/// template selected from `i18n.noMatchThisWeek*`. `dropDate` is truncated
/// to the UTC day of the cron firing so `@@unique([userId, dropDate])`
/// doubles as an idempotency guard against accidental re-fires within the
/// same drop. Read by `/admin/analytics/no-match-notices` for week-over-week
/// trend tracking — a rising count signals the matchmaker / user base needs
/// attention before users churn.
model NoMatchNotice {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  tier     Int
  sentAt   DateTime @default(now()) @map("sent_at")
  dropDate DateTime @map("drop_date")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dropDate])
  @@index([dropDate])
  @@index([sentAt])
  @@map("no_match_notices")
}

/// Hand-curated first-date venues, scoped per university domain. This is the
/// PRIMARY source for the concierge venue picker (PRODUCT_SPEC §3.7): Google
/// Places is only consulted as a fallback when no curated venue is in range.
/// The product's hyper-local rule (both matched users share `universityDomain`)
/// keeps the geography — and therefore the curation effort — small.
///
/// Standalone model (no user relation): scoped by the `universityDomain` string
/// the same way the matching pipeline filters candidates. Populated by
/// `scripts/seed-venues.mjs` (Places-backed pull → manual review → import).
model CuratedVenue {
  id               String    @id @default(uuid()) @db.Uuid
  universityDomain String?   @map("university_domain")
  /// Primary availability scope. University domain is now affinity only.
  cityKey          String?   @map("city_key")
  name             String
  address          String
  lat              Float
  lng              Float
  /// Google Maps deep-link (always present for seeded venues; nullable for
  /// hand-entered rows). Surfaced in the scheduled-date DM.
  googleMapsUri    String?   @map("google_maps_uri")
  /// Google Places resource id. Lets the re-validation cron re-fetch the exact
  /// place (Place Details) rather than re-searching by name. Null for
  /// hand-entered rows (which the cron skips).
  placeId          String?   @map("place_id")
  /// The venue's UTC offset in minutes (e.g. Kyiv = 180). Used with
  /// `openingHours` to evaluate open-at-slot in local wall-clock time.
  utcOffsetMinutes Int?      @map("utc_offset_minutes")
  /// Places `regularOpeningHours` (`periods[]`), captured at seed + refreshed by
  /// the re-validation cron. Null = unknown → treated as "open" (never filtered).
  openingHours     Json?     @map("opening_hours")
  /// One of VENUE_CATEGORY_WHITELIST (validated in app code, not a Prisma enum,
  /// so the shared whitelist stays the single source of truth).
  category         String
  /// 1 = best first-date spot, 3 = acceptable. Lower wins ties in ranking.
  priority         Int       @default(2)
  /// `base` (default, student-friendly ≤ MODERATE price cap) | `premium`
  /// (Gennety Premium tier — may be EXPENSIVE, shown but locked in the
  /// venue-change board unless a participant has an active subscription).
  /// Whitelist-validated in app code, not a Prisma enum, same as `category`.
  /// See PRODUCT_SPEC.md §Premium / §3.7b.
  tier             String    @default("base")
  vibeTags         String[]  @default([]) @map("vibe_tags")
  /// Canonical V2 facets and positively evidenced capabilities.
  facetTags        String[]  @default([]) @map("facet_tags")
  hardCapabilities String[]  @default([]) @map("hard_capabilities")
  rating           Float?
  userRatingCount  Int?      @map("user_rating_count")
  priceLevel       String?   @map("price_level")
  primaryType      String?   @map("primary_type")
  editorialSummary String?   @map("editorial_summary")
  /// unknown | provider | operator_confirmed | always_open
  hoursConfidence  String    @default("unknown") @map("hours_confidence")
  /// Google Places photo resource names (`places/X/photos/Y`) for this venue,
  /// refreshed by the re-validation cron inside the SAME Place Details call it
  /// already makes for hours and rating. Google bills Place Details by the most
  /// expensive field requested rather than by the sum, so carrying `photos` in
  /// that existing request costs strictly less than the separate lookup it
  /// replaces — and the venue-change board then reads its pictures from here
  /// instead of paying one lookup per venue per process (a cache that went cold
  /// on every deploy).
  ///
  /// Empty until the cron has reached the row — a full Kyiv cycle is ~10 nights
  /// at 30 distinct PLACES a night — which is why `withCuratedPhotos` survives
  /// as the runtime fallback rather than being deleted with the old path.
  /// (Places, not rows, only since 2026-08-23: the cron used to spend one
  /// request per per-domain copy and skip no market, so the real cycle was 57
  /// nights and this column reached 0 of 275 Kyiv places while filling 90 rows
  /// in cities that cannot hold a match.)
  ///
  /// An EMPTY Places answer must never overwrite a stored value: an absent
  /// `photos` field is indistinguishable from a partial 200, and trusting one
  /// blanked a venue on the board for a day once already (`venue-change.ts` →
  /// `lookupAndCachePhotos`). Distinct from the retired `photoUrl` below: these
  /// are provider pointers we re-resolve, not operator-owned imagery.
  photoRefs        String[]  @default([]) @map("photo_refs")
  /// RETIRED 2026-07-25 — no longer read or written. Intended for a hand-filled
  /// operator photo, but no row was ever populated (0/537 in production), so it
  /// only ever produced photo-less date cards for curated picks. Venue imagery
  /// now comes exclusively from Google Places, resolved from `placeId` at
  /// assignment time (`fetchPlacePhotoName`). Column kept so the change stays
  /// additive — drop it in a separate, deliberate migration. If operator-owned
  /// photos are ever wanted back, reintroduce them as an explicit override with
  /// a seeder path, not a silently-null field.
  photoUrl         String?   @map("photo_url")
  active           Boolean   @default(true)
  /// Set when the row was last confirmed live against Places (by the seeder
  /// import, or the re-validation cron). Oldest-first is the cron's scan order.
  lastVerifiedAt   DateTime? @map("last_verified_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([universityDomain, category, active])
  @@index([cityKey, tier, active])
  @@map("curated_venues")
}

/// Клиентская воронка нативного приложения (iOS 6.2).
///
/// Сюда попадает ТОЛЬКО то, чего сервер не видит в принципе: уход с шага
/// онбординга до отправки, отказ в системном разрешении, исход нативной
/// проверки живости, показ пейволла и тикет-гейта без покупки, фатальная
/// клиентская ошибка. Всё, что является вызовом API, сервер уже наблюдает, и
/// дублирующее событие здесь создало бы второй источник правды.
///
/// `id` — UUID, сгенерированный клиентом, и он же ключ идемпотентности:
/// повторная доставка батча (сеть отвалилась после записи, но до ответа) не
/// задваивает строки.
///
/// **Две отметки времени, и обе нужны.** `occurredAt` — часы устройства, то
/// есть единственное, что знает клиент, и поправить их нечем: батч уходит и до
/// авторизации, так что серверного времени в нём взяться неоткуда. `receivedAt`
/// — наши часы. Сбитые часы телефона искажают воронку ровно до тех пор, пока
/// анализ смотрит только на первую.
///
/// Связь с `users` есть и каскадная — намеренно, по тому же правилу, что
/// заведено для `bot_sessions` в `account-deletion.ts`: строка с `user_id`
/// удалённого аккаунта — это не стёртые данные. События, снятые до
/// авторизации, `user_id` не имеют вовсе и уходят по ретеншену.
model ClientEvent {
  /// UUID от клиента. Первичный ключ, поэтому повтор батча — no-op.
  id         String   @id @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  /// Анонимный идентификатор установки. До авторизации — единственное, чем
  /// человек опознаётся; это НЕ `identifierForVendor` и не рекламный id.
  installId  String   @map("install_id")
  type       String
  /// Только скаляры из закрытых перечней клиента. Формат значений проверяется
  /// на приёме (`^[a-z0-9_]{1,32}$`), поэтому свободному тексту и PII сюда не
  /// попасть, даже если клиент однажды пришлёт их по ошибке.
  props      Json     @default("{}")
  occurredAt DateTime @map("occurred_at")
  receivedAt DateTime @default(now()) @map("received_at")
  appVersion String?  @map("app_version")
  appBuild   String?  @map("app_build")
  osVersion  String?  @map("os_version")
  locale     String?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type, occurredAt])
  @@index([installId, occurredAt])
  @@index([receivedAt])
  @@map("client_events")
}

/// Snapshot of a weekly founder matches report (gated by `FOUNDER_NOTIFY_ENABLED`).
/// Built after the Thursday batch (`notifyFounderWeeklyMatches`), stored so the
/// tokenized report page (`GET /v1/founder/report/:token`) renders a stable view
/// regardless of later profile edits. Contains PII (names, cities, photo refs,
/// attractiveness scores) but never `psychologicalSummary`/AI-memory dumps. The
/// `token` is a cryptographically-random unguessable string = the page's only
/// authorization (no login), so it must never be logged.
model FounderReport {
  id        String    @id @default(uuid()) @db.Uuid
  /// Crypto-random URL token = the report page's sole authorization.
  token     String    @unique
  /// UTC day of the batch this report covers (dedup + display).
  weekOf    DateTime  @map("week_of")
  /// Assembled `WeeklyMatchesReport` snapshot (pairs + user cards + photo refs).
  dataJson  Json      @map("data_json")
  /// When the token stops working. The page shows real users' names, photos,
  /// cities and attractiveness scores behind a token-in-the-URL sole-auth
  /// boundary, so that token also lands in reverse-proxy access logs and
  /// browser history. An expiry bounds how long a leaked log line stays useful.
  ///
  /// Nullable, and null means "never expires": rows created before this column
  /// existed must keep working, so old founder links are not broken by the
  /// upgrade. New rows are stamped by `notifyFounderWeeklyMatches`.
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("founder_reports")
}
