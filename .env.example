# Production-like environment template.
# Do not commit real values. Local overrides belong in `.env.local`.

# --- Telegram ----------------------------------------------------------------
BOT_TOKEN=your_telegram_bot_token
BOT_USERNAME=gennetybot
WEBAPP_URL=https://dating-calendar.gennety.com
# Optional override for the post-date Feedback Mini App bundle URL. When
# empty, derived from WEBAPP_URL by appending `/feedback.html` — Vite
# emits `index.html` (calendar), `feedback.html` (feedback),
# `location.html` (venue handoff), and `onboarding.html` (Telegram
# onboarding) into the same `/var/www/dating-app` root that Caddy serves.
WEBAPP_FEEDBACK_URL=

# Optional Telegram visual affordances.
CUSTOM_EMOJI_LIKE_ID=
CUSTOM_EMOJI_DISLIKE_ID=
CUSTOM_EMOJI_MENU_ID=
CUSTOM_EMOJI_ACCEPT_ID=
CUSTOM_EMOJI_DECLINE_ID=
# Optional: animated checkmark next to a verified partner's name in the
# match-pitch caption. Empty = static `✓` glyph (still works, just no animation).
CUSTOM_EMOJI_VERIFIED_ID=
MESSAGE_EFFECT_MATCH_ID=5104841245755180586
# Optional Bot API 7.6 effect on the T+24h post-date feedback DM. Empty
# falls through to no effect — the form/voice keyboard still works.
MESSAGE_EFFECT_FEEDBACK_ID=
# Effect on the paid-Rematch "found someone" DM (PRODUCT_SPEC §3.11), played
# after the ~10s search animation. Empty = no animation; the DM still sends.
# Never put an effect on the Rematch OFFER card instead — see §3.5b on why a
# flourish beside a request for money reads as marketing.
MESSAGE_EFFECT_REMATCH_ID=

# --- Database / Supabase -----------------------------------------------------
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Private storage buckets.
SUPABASE_SELFIE_BUCKET=selfies
SUPABASE_PHOTO_BUCKET=profile-photos
SUPABASE_CHAT_BUCKET=chat-attachments
# Voice prompts uploaded by a native client. Telegram-recorded prompts never
# land here — those are a file_id. PRIVATE bucket.
SUPABASE_VOICE_BUCKET=voice-prompts

# --- AI / Email --------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key
ONBOARDING_FACT_COLLECTOR_ENABLED=false
# AI-memory export (Magic Prompt / "import your ChatGPT memory", PRODUCT_SPEC
# §1.1/§1.3). ON by default — set to `false` to hide the whole branch: the
# onboarding Mini App skips the choice screen, POST /v1/telegram-onboarding/
# ai-memory 404s, and onboarding runs vibe → photos with the deterministic
# fallback summary (exactly the existing "declined" path). Nothing is written
# to the DB because of the flag, so flipping it back on needs no backfill.
AI_MEMORY_EXPORT_ENABLED=true
# Animated AI emoji (from https://t.me/addemoji/AIActions) that leads each rich
# "thinking" shimmer block. Empty = plain glyph, no animation. Get an id with
# getStickerSet(name="AIActions").
# There is deliberately NO env flag for the rich path itself: each call site
# opts in with `rich: true` in code (deploy.md → "Chat progress streams"),
# because clients treat a rich draft as a generated AI reply and may reserve
# scroll space, so that tradeoff is chosen per flow and never globally.
CUSTOM_EMOJI_THINKING_ID=
# Per-step icons are NOT env: a beat's animated glyph lives in the baked
# AI_EMOJI map (apps/bot/src/services/ai-emoji.ts), because it is a product
# choice rather than per-deployment config. Source new ids with:
#   pnpm tsx apps/bot/scripts/dev/list-ai-emojis.ts
RESEND_API_KEY=re_your_resend_api_key
SMTP_FROM=onboarding@yourdomain.com
OTP_LOG_TO_CONSOLE=false

# --- Admin Analytics API -----------------------------------------------------
ADMIN_API_KEY=your_long_random_secret
ADMIN_PORT=3100
# Concrete dashboard origin (comma-separated for multiple). Required for
# browser access: an unset or "*" value makes the admin API deny cross-origin
# requests rather than echo a wildcard from an authenticated surface.
ADMIN_DASHBOARD_ORIGIN=https://your-dashboard.example
# Comma-separated Telegram ids of test/QA/founder accounts. The admin
# account-health classifier drops them from EVERY denominator, so leaving this
# empty silently inflates every conversion on the dashboard. Analytics only —
# it never touches matching, workers or notifications.
ADMIN_TEST_TELEGRAM_IDS=

# --- Public /v1/* API --------------------------------------------------------
# Generate at least 32 random bytes (64 hex characters), e.g. with a password
# manager or `openssl rand -hex 32`. Never reuse this value between environments.
JWT_SECRET=your_64_char_random_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PUBLIC_PORT=3101
# Comma-separated browser origins allowed to call /v1/*. Empty = deny cross-origin
# (native mobile clients send no Origin header and are unaffected). Do NOT use `*`
# in production — list the concrete origins: the Mini App host plus any web signup
# site, e.g. PUBLIC_CORS_ORIGIN=https://dating-calendar.gennety.com
PUBLIC_CORS_ORIGIN=https://dating-calendar.gennety.com

# --- Push (native iOS, direct APNs; Expo rail retired 2026-07-18) ------------
# Path to the .p8 APNs Auth Key (scp'd to the server, never committed).
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.gennety.ios
# sandbox (dev/TestFlight) | production (App Store builds)
APNS_ENVIRONMENT=sandbox

# --- Native-app phone rail (Registration v2 general track on iOS) ------------
# Primary: Twilio Verify (no phone number purchase needed).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Optional secondary: Telegram Gateway (gateway.telegram.org account token).
TELEGRAM_GATEWAY_TOKEN=
# twilio (default) | telegram — which rail tries first.
PHONE_CODE_PRIMARY_PROVIDER=twilio

# --- "Continue with Telegram" on iOS (POST /v1/auth/telegram) ----------------
# The bot's Client ID from @BotFather -> Bot Settings -> Login Widget ->
# "Switch to OpenID Connect Login". This is the `aud` every ID token is checked
# against, so an empty value fails closed (503 + features.telegramAuth false).
# There is deliberately NO client secret: we verify an already-issued ID token
# against Telegram's public keys and never exchange an authorization code.
TELEGRAM_LOGIN_CLIENT_ID=

# --- Native iOS forced-update kill switch (GET /v1/app/config) ---------------
IOS_MIN_SUPPORTED_APP_VERSION=

# --- Identity liveness (AWS Rekognition Face Liveness) -----------------------
# Replaced Persona 2026-07-26. Uses the same AWS_* credentials below; there is
# no separate provider key and no sandbox/production split.
# A production-like process REFUSES TO BOOT unless the next three are set.
FACE_LIVENESS_ENABLED=true
MANDATORY_VERIFICATION_ENABLED=true
# Region for liveness ONLY — deliberately separate from AWS_REGION below.
# Face Liveness is NOT served in eu-central-1 (Frankfurt): a region without it
# returns a message-less AccessDeniedException that looks exactly like an IAM
# denial. eu-west-1 (Ireland) is the only EU region that serves it, and is where
# our Supabase project lives. The detector must stream to the region the session
# was created in, so this value is handed to the client verbatim.
FACE_LIVENESS_REGION=eu-west-1
# IAM role the backend assumes to mint the short-lived credentials the on-device
# detector uses to stream its video. Scoped to
# rekognition:StartFaceLivenessSession only — see deploy.md for both policies.
LIVENESS_STS_ROLE_ARN=arn:aws:iam::000000000000:role/GennetyLivenessClient
# Minimum liveness confidence (0..1) to count as passed. Below it the check is
# RETRYABLE (new session), never `rejected` — a shaky capture is not an impostor.
FACE_LIVENESS_MIN_CONFIDENCE=0.8
# Credential lifetime. 900s is AWS's AssumeRole floor and is plenty: a liveness
# session itself expires 3 minutes after it is created.
LIVENESS_CREDENTIALS_TTL_SECONDS=900

# --- Face match / Elo seed ---------------------------------------------------
# `rekognition` calls AWS CompareFaces. `disabled` short-circuits everything
# to a synthetic similarity=1 (use in CI/local dev without AWS credentials).
FACE_MATCH_PROVIDER=rekognition
# Minimum similarity (0..1) for the `verified` decision. AWS recommends
# ≥0.80 for security-grade applications; 0.85 leans slightly stricter
# because dating-profile mismatches have higher harm than the friction
# of a manual review. Lower → fewer manual reviews, higher impostor risk.
FACE_MATCH_THRESHOLD_VERIFY=0.85
# Lower bound (0..1) for the manual-review band. Scores in
# [REVIEW, VERIFY) → `pending_review` (admin moderates); a score below
# REVIEW with a *detected* face → `rejected` (likely impostor photo).
FACE_MATCH_THRESHOLD_REVIEW=0.75
# Minimum number of profile photos (with a detectable face) that must
# score ≥ VERIFY for the user to be auto-verified. Photos without a
# detectable face (group shots, scenery) are excluded from the count
# rather than treated as hard fails. Default 1 — a single solid match
# is strong evidence. Raise to 2+ if ops wants corroborating angles.
FACE_MATCH_MIN_VERIFIED_PHOTOS=1
ELO_VISION_SEED_ENABLED=false
PROFILE_MEDIA_VALIDATION_ENABLED=true

# Voice prompts (VOICE_PROMPT_PRODUCT_SPEC.md). Ships dark: it adds a step to a
# live onboarding funnel and a message to every pitch, so flip it deliberately
# and watch /admin/analytics/onboarding-funnel for the voice_prompt step after.
VOICE_PROMPT_ENABLED=false
PROFILE_MEDIA_VALIDATION_FAIL_OPEN=false
PROFILE_VIDEO_MAX_ANALYSIS_FRAMES=24
PROFILE_VIDEO_VALIDATION_TIMEOUT_MS=60000

# AWS. One IAM user covers both jobs. Face match needs
# rekognition:CompareFaces + DetectFaces; media validation adds
# DetectModerationLabels; identity liveness adds CreateFaceLivenessSession +
# GetFaceLivenessSessionResults, plus sts:AssumeRole on LIVENESS_STS_ROLE_ARN.
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Matching: relationship intent (V_intent) ---------------------------------
# Floor of the soft `V_intent` multiplier — how hard a pair at opposite ends of
# the intent axis (spark | open | falling | longterm, PRODUCT_SPEC §1.3) can be
# damped. 1.0 = the factor is a pure no-op, which is how it ships: the screen
# collects answers while scoring is unchanged. Launch value ≈ 0.85 (range ×1.18
# — deliberately weaker than V_type's 0.7/×1.43 and nothing like V_league's
# 0.05/×20). There is no separate feature flag: the screen is an ordinary
# onboarding step, so the floor is the only thing to gate.
INTENT_FLOOR=1.0

# --- Venue picker ------------------------------------------------------------
PLACES_API_KEY=

# --- Map basemap -------------------------------------------------------------
# CARTO basemaps key for the /v1/maptiles raster proxy (the dark map under the
# departure-point picker and the Living Canvas). Free — 5M tiles/month, no CARTO
# account, emailed instantly from carto.com/basemaps/apikey.
# Leaving it empty does NOT fail loudly: CARTO answers 200 with a valid PNG that
# has "API KEY REQUIRED" burned into it, so the map just looks broken. The boot
# warning from startPublicServer is the only signal.
# Server-side only — the Mini App talks to our proxy, never to CARTO.
CARTO_API_KEY=

# --- Cron / worker overrides -------------------------------------------------
CRON_TIMEZONE=Europe/Kyiv
MATCH_CRON_SCHEDULE=0 18 * * 4
NO_MATCH_NOTICE_CRON_SCHEDULE=15 18 * * 4
PRE_MATCH_ANNOUNCE_CRON_SCHEDULE=0 18 * * 3
EXPIRY_CRON_SCHEDULE=*/15 * * * *
PROPOSAL_COUNTDOWN_CRON_SCHEDULE=*/5 * * * *
MATCH_NUDGE_CRON_SCHEDULE=0 * * * *
RE_ENGAGEMENT_CRON_SCHEDULE=*/5 * * * *
STATUS_TIMER_CRON_SCHEDULE=* * * * *
AUTO_UNSUSPEND_CRON_SCHEDULE=0 * * * *
EMBEDDING_REFRESH_CRON_SCHEDULE=*/5 * * * *
SELFIE_RETENTION_CRON_SCHEDULE=30 3 * * *
# DAU/MAU reconcile. Note the timezone: this one is scheduled in **UTC**, not
# Europe/Kyiv like every other cron here, because it closes a UTC-bucketed day
# rather than reacting to when a person is awake. The default is the right
# value — set it only to pause the sweep (a far-future expression), never to
# retime it into Kyiv.
ACTIVITY_ROLLUP_CRON_SCHEDULE=20 0 * * *
DATE_LIFECYCLE_TICK_MS=120000
DISPATCH_DELAY_MS=2000

# Production safety: keep empty. Local-only bypass lives in `.env.local`.
DEV_OTP_BYPASS_TELEGRAM_IDS=
VENUE_INTENT_V2_ENABLED=false
VENUE_INTENT_V2_SHADOW_PERCENT=0
VENUE_INTENT_V2_ROLLOUT_PERCENT=0

# Season + weather as a SOFT ranking multiplier on the AUTOMATIC venue
# assignment (PRODUCT_SPEC §3.7). Never a filter: a rained-out park sinks a few
# places among comparable venues and stays fully selectable, because a wrong
# forecast or a dead provider must not be able to withhold a venue. Clamped to
# [0.8, 1.1] in code, so context can never outrank fit or quality.
# Only the venue-intent-v2 selector reads it, so it is inert unless
# VENUE_INTENT_V2_ROLLOUT_PERCENT is above 0. Provider is Open-Meteo — no API
# key, no account, no quota. Off (default) → no forecast is ever requested.
VENUE_SEASON_WEATHER_ENABLED=false
# Upper bound on how long a selection waits for the forecast; past it the run
# continues weather-blind rather than making the pair wait.
VENUE_WEATHER_TIMEOUT_MS=2500
# In-memory forecast cache TTL (per process, resets on restart).
VENUE_WEATHER_CACHE_TTL_MS=3600000

# How many DISTINCT PLACES the nightly curated re-validation cron re-checks
# against Google Places (`services/venue-revalidation.ts`). This is the whole
# nightly Places bill for that cron: one billed Place Details request per place,
# which then settles every per-`universityDomain` copy of it at once.
#
# It bounds cost, not freshness directly — the two trade off through the cycle
# length. Kyiv is ~275 distinct places, so 30/night is a ~10-night full pass and
# 10/night is ~27 nights. Raise it while `photoRefs` coverage is still filling in
# (the venue-change board pays a live lookup per card until then), lower it once
# it has, since a closed venue is caught long before the product schedules many
# dates. Unset → 30. A junk value is ignored with a warning, never silently
# treated as zero.
VENUE_REVALIDATION_BATCH_SIZE=30

# Client-only funnel sink for the native app (POST /v1/client/events, iOS 6.2).
# Takes ONLY what the server is blind to by construction: leaving an onboarding
# step before submitting, a denied system permission, the liveness outcome, a
# paywall or ticket gate shown without a purchase, a fatal client error.
# Anything that is an API call is already observed server-side.
#
# Off by default, and that is NOT caution: the app's privacy manifest currently
# states that we collect no analytics data. Turning the sink on before that
# manifest and the App Privacy questionnaire are updated would make the
# statement false — so the order is manifest and questionnaire FIRST, flag
# second. Off → the route answers 404 (the gate sits before auth).
#
# Rows are swept after 90 days by the retention cron, by receivedAt (occurredAt
# is the device clock). That window is the same promise the manifest makes.
CLIENT_EVENTS_ENABLED=false

# Bonus Campus Drop (PRODUCT_SPEC §Campus Radar): an out-of-cycle drop for one
# university whose verified cohort just grew, so a campus that fills up on
# Tuesday does not sit unused until Thursday.
#
# Off by default, and this one is caution — it is a SECOND entry point into the
# matching allocator. A single-cohort run can take a candidate the globally
# optimal Thursday batch needed, which is the same hazard
# REMATCH_PRE_BATCH_BLACKOUT_HOURS exists to bound, and the blackout below is
# the same answer. Off → the cron is not registered at all.
#
# Note before flipping it: production currently has ZERO accounts carrying a
# universityDomain (every one is on the general/phone track), so with the flag
# on it would find no cohort and pair nobody. It becomes meaningful at a real
# campus launch, not before.
CAMPUS_DROP_ENABLED=false
# How many students a campus must newly verify inside the window to earn a drop.
# Low enough to fire on a campus push, high enough that two friends signing up
# together do not trigger one. Unset → 6.
CAMPUS_DROP_GROWTH_THRESHOLD=6
# The window that growth is measured over. Unset → 48.
CAMPUS_DROP_WINDOW_HOURS=48
# How long a campus waits between bonus drops. The anchor is the newest `campus`
# match for that domain — derived state, so there is no counter to drift.
# Unset → 168 (a week).
CAMPUS_DROP_COOLDOWN_HOURS=168
# Hours before the ordinary drop in which a campus drop stands down. 0 disables
# the check outright rather than making every run "imminent". Unset → 6.
CAMPUS_DROP_PRE_BATCH_BLACKOUT_HOURS=6
# Hourly rather than by the minute: what it watches moves in days, not ticks.
CAMPUS_DROP_CRON_SCHEDULE=30 * * * *

# Launch Events (LAUNCH_EVENTS_PRODUCT_SPEC.md): the offline mixer — waitlist
# admission, a free door ticket, a signed QR, the venue gatekeeper portal, and
# the in-event pairing rounds.
#
# Off by default, and off here is genuinely inert rather than merely quiet: the
# verification pipeline's admission hook is not wired at all (so a registration
# cannot land in a queue nobody is watching), every /admin/events route answers
# 404, and so do /v1/events/* and /gk/*. The tables exist and stay empty.
#
# Flipping it on is NOT the same as opening applications: that additionally
# needs an event created in the hub, and one with autoApplyOnVerification=true
# before anything is collected automatically. Applying is an explicit act.
EVENTS_FEATURE_ENABLED=false

# HMAC key for door-entry QR codes. Its OWN secret, never JWT_SECRET — the demo
# once inherited production's JWT key and made every /v1/* token cross-valid
# (DEMO_MODE.md → the isolation gate), so every new secret gets its own key AND
# a line in deploy-demo.sh's MUST_DIFFER list.
#
# Generate with: openssl rand -hex 32
#
# Empty is fail-closed on purpose: minting and verifying both answer 503 below
# 32 bytes rather than signing with a blank string, which would validate every
# forgery while looking exactly like a working door.
EVENT_QR_SECRET=

# Party Mode's round tick (LAUNCH_EVENTS §9.2). Registered only when
# EVENTS_FEATURE_ENABLED is on, so with events off the worker does not exist.
#
# One minute is deliberately finer than the 35-minute round it drives: which
# round is due is a pure function of the clock, so this only decides how LATE a
# round can open — and a coarse tick means people standing around after the
# product has told them a round began. 0 disables the rounds without disabling
# the rest of the feature (tickets and the door still work).
EVENT_ROUND_TICK_MS=60000
